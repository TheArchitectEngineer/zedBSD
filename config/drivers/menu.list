# category|platforms|config keys
# A "*" row is shared by every CPU: a driver it does not name is in Platform.
# A row naming platforms moves its drivers into the category on those
# platforms only, ahead of the shared rows there; its "fixed" stands for the
# always-built drivers whose rows name the platform.
Disk|*|CONFIG_DRIVER_PCI_NVME CONFIG_DRIVER_PCI_AHCI CONFIG_DRIVER_USB_STORAGE
Input|*|CONFIG_DRIVER_USB_HID CONFIG_DRIVER_PCI_LPSS_I2C
GPU|*|CONFIG_DRIVER_GRAPHICS CONFIG_DRIVER_PCI_VENUS CONFIG_DRIVER_PCI_I915 CONFIG_DRIVER_PCI_NVRTX CONFIG_DRIVER_BCM2711_GPU CONFIG_DRIVER_BCM2711_VIDEO
Audio|*|CONFIG_DRIVER_PCI_HDA CONFIG_DRIVER_BCM2711_AUDIO
Ethernet|*|CONFIG_DRIVER_BCM2711_GENET CONFIG_DRIVER_NE2000 CONFIG_DRIVER_USB_CDC_NCM CONFIG_DRIVER_USB_CDC_ECM CONFIG_DRIVER_LGY98
WiFi|*|CONFIG_DRIVER_PCI_INTEL_AX211 CONFIG_DRIVER_USB_RTL8822BU CONFIG_DRIVER_BCM2711_WIFI
USB|*|CONFIG_DRIVER_PCI_UHCI CONFIG_DRIVER_PCI_EHCI CONFIG_DRIVER_PCI_XHCI CONFIG_DRIVER_USB_HUB CONFIG_DRIVER_USB_CCID CONFIG_DRIVER_USB_BT CONFIG_DRIVER_TYPEC
Platform|*|CONFIG_DRIVER_ACPI CONFIG_DRIVER_BCM2711_BT CONFIG_DRIVER_BCM2711_VCHIQ
# Every PC-98 driver is under Platform on the PC-9800 (2026-10-14 user,
# WS232: "PC98のマウスとかSCSIとかすべてのドライバは、DriversのPlatformに
# 入れてください").
Platform|pc98|fixed CONFIG_DRIVER_GRAPHICS CONFIG_DRIVER_LGY98
