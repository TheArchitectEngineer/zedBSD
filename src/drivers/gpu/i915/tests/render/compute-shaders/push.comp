/*
 * PUSH: push constants, a uniform block and three storage buffers, the
 * second bound with a dynamic offset.
 */
#version 450

layout(local_size_x = 32) in;

layout(push_constant) uniform P { uint k0; uint k1; uint n; } p;

layout(std140, set = 0, binding = 0) uniform U { uvec4 u0; uvec4 u1; uvec4 u2; } u;
layout(std430, set = 0, binding = 1) readonly buffer A { uint a[]; };
layout(std430, set = 0, binding = 2) readonly buffer B { uint b[]; };
layout(std430, set = 0, binding = 3) buffer C { uint c[]; };

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= p.n)
        return;
    c[i] = a[i] * p.k0 + b[i] + u.u0.x + (u.u1.y ^ p.k1) + u.u2.z * i + u.u2.w;
}
