/*
 * MANYOPS: one step of a recurrence, o[i] = o[i] * 3 + k + i, run by many
 * dispatches in one submission with k from the push constants.
 */
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer O { uint o[]; };

layout(push_constant) uniform P { uint k; } p;

void main()
{
    uint i = gl_GlobalInvocationID.x;

    o[i] = o[i] * 3u + p.k + i;
}
