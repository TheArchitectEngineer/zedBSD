# The Linux build of libgif-compat.so; the zedBSD build remains in Makefile.
# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
KEILAND_LINUX_GIF_COMPAT_SOURCES := userland/desktop/libgif-compat/decode.c \
	userland/desktop/libgif-compat/lzw.c
$(eval $(call KEILAND_LINUX_LIBRARY,gif-compat,libgif-compat.so,$(KEILAND_LINUX_GIF_COMPAT_SOURCES),,-lm,userland/desktop/libgif-compat/exports.map))
