package=nvidia-gsp-firmware
package-version=570.144
consumer=nvrtx kernel driver (src/drivers/gpu/nvrtx, plan/ws037/nvrtx-design.md section 9)
installed-directory=/lib/firmware/nvidia/tu102
installed-file=gsp/gsp-570.144.bin
installed-file=gsp/bootloader-570.144.bin
installed-file=gsp/booter_load-570.144.bin
installed-file=gsp/booter_unload-570.144.bin
installed-file=acr/bl.bin
installed-alias=WHENCE links nvidia/tu104/gsp, nvidia/tu106/gsp and nvidia/tu10[46]/acr/bl.bin to tu102; the image builder installs files only, so no copies are made and nvrtx reads the tu102 directory for every TU10x chip
not-installed=gsp/gen_bootloader-570.144.bin (not used on the Turing boot path)
installed-license=/usr/share/licenses/nvidia-gsp-firmware/LICENCE.nvidia
installed-whence=/usr/share/licenses/nvidia-gsp-firmware/WHENCE

