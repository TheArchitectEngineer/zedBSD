package=nvidia-gsp-firmware
package-version=570.144
consumer=nvrtx kernel driver (src/drivers/gpu/nvrtx, plan/ws037/nvrtx-design.md section 9, plan/ws242/phase001/phase.md)
installed-directory=/lib/firmware/nvidia
installed-file=tu102/gsp/gsp-570.144.bin
installed-file=tu102/gsp/bootloader-570.144.bin
installed-file=tu102/gsp/booter_load-570.144.bin
installed-file=tu102/gsp/booter_unload-570.144.bin
installed-file=tu102/acr/bl.bin
installed-file=tu116/gsp/booter_load-570.144.bin
installed-file=tu116/gsp/booter_unload-570.144.bin
installed-file=ga102/gsp/gsp-570.144.bin
installed-file=ga102/gsp/bootloader-570.144.bin
installed-file=ga102/gsp/booter_load-570.144.bin
installed-file=ga102/gsp/booter_unload-570.144.bin
installed-file=ad102/gsp/bootloader-570.144.bin
installed-file=ad102/gsp/booter_load-570.144.bin
installed-file=ad102/gsp/booter_unload-570.144.bin
installed-alias=WHENCE links nvidia/tu104/gsp, nvidia/tu106/gsp and nvidia/tu10[46]/acr/bl.bin to tu102, nvidia/tu117/gsp to tu116, nvidia/tu116/gsp/{gsp,bootloader}-570.144.bin to tu102, nvidia/ga10[3467]/gsp to ga102, nvidia/ad10[3467] to ad102 and nvidia/ad102/gsp/gsp-570.144.bin to ga102; the image builder installs files only, so no copies are made and nvrtx maps each chip to the directories it reads (src/drivers/gpu/nvrtx/identify.c)
not-installed=tu102/gsp/gen_bootloader-570.144.bin (not used on the Turing boot path)
not-installed=tu116/acr/bl.bin (byte-identical to tu102/acr/bl.bin, which nvrtx reads for TU116 and TU117)
not-installed=ad102/gsp/scrubber-570.144.bin (not used on the boot path nvrtx follows, as nouveau does not use it)
installed-license=/usr/share/licenses/nvidia-gsp-firmware/LICENCE.nvidia
installed-whence=/usr/share/licenses/nvidia-gsp-firmware/WHENCE

