#version 450
// vkmatrix perf-alu4 (q1539): perf-alu's 64 multiply-adds as four independent chains of 16,
// so a pixel's operations do not wait on each other; then a colour.
layout(push_constant) uniform Push { float red; } push;
layout(location = 0) out vec4 colour;
void main()
{
	float a = push.red;
	float b = push.red * 0.5;
	float c = push.red * 0.25;
	float d = push.red * 0.125;
	a = a * 0.999 + 0.0005;
	b = b * 0.999 + 0.0005;
	c = c * 0.999 + 0.0005;
	d = d * 0.999 + 0.0005;
