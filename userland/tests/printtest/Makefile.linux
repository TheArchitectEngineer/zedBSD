# The independent Linux build of printtest (ws145-p005): the test client of libkeiland's printers.
KEILAND_LINUX_PRINTTEST_SOURCES := userland/tests/printtest/main.c
$(eval $(call KEILAND_LINUX_PROGRAM,printtest,bin,$(KEILAND_LINUX_PRINTTEST_SOURCES),libkeiland.so libwayland-client.so,))
