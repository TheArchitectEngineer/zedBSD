+    const ArchSpec &target_arch)
+    : lldb_private::RegisterInfoInterface(target_arch),
+      m_register_info_p(g_register_infos_x86_64),
+      m_register_count(static_cast<uint32_t>(
+          sizeof(g_register_infos_x86_64) /
+          sizeof(g_register_infos_x86_64[0]))),
+      m_user_register_count(
+          static_cast<uint32_t>(k_num_user_registers_x86_64)) {
+  assert(target_arch.GetMachine() == llvm::Triple::x86_64 &&
+         "this system runs on one architecture only");
+}
