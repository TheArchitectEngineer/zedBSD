+
+llvm::VersionTuple HostInfoZedBSD::GetOSVersion() {
+  struct utsname un;
+
+  ::memset(&un, 0, sizeof(un));
+  if (::uname(&un) < 0)
+    return llvm::VersionTuple();
+
+  uint32_t major = 0;
+  uint32_t minor = 0;
+  switch (::sscanf(un.release, "%" PRIu32 ".%" PRIu32, &major, &minor)) {
+  case 1:
+    return llvm::VersionTuple(major);
+  case 2:
+    return llvm::VersionTuple(major, minor);
+  default:
+    return llvm::VersionTuple();
+  }
+}
+
+std::optional<std::string> HostInfoZedBSD::GetOSBuildString() {
+  struct utsname un;
+
+  ::memset(&un, 0, sizeof(un));
+  if (::uname(&un) < 0)
+    return std::nullopt;
+  return std::string(un.version);
+}
+
+FileSpec HostInfoZedBSD::GetProgramFileSpec() {
+  static FileSpec g_program_filespec;
+  return g_program_filespec;
+}
