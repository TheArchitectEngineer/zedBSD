+
+#include "RegisterContextZedBSD_x86_64.h"
+#include "RegisterContextPOSIX_x86.h"
+
+#include <cassert>
+#include <cstddef>
+#include <vector>
+
+using namespace lldb_private;
+using namespace lldb;
+
+// The order here is this plugin's own.  What the system reports is the set
+// of registers it keeps for a stopped thread; the two segment bases are
+// among them, while the four segment selectors it does not keep are
+// reported as zero so that a debugger asking for the usual list gets an
+// answer for every name on it.
+typedef struct _GPR {
+  uint64_t rax;
+  uint64_t rbx;
+  uint64_t rcx;
+  uint64_t rdx;
+  uint64_t rsi;
+  uint64_t rdi;
+  uint64_t rbp;
+  uint64_t rsp;
+  uint64_t r8;
+  uint64_t r9;
+  uint64_t r10;
+  uint64_t r11;
+  uint64_t r12;
+  uint64_t r13;
+  uint64_t r14;
+  uint64_t r15;
+  uint64_t rip;
+  uint64_t rflags;
+  uint64_t cs;
+  uint64_t ss;
+  uint64_t ds;
+  uint64_t es;
+  uint64_t fs;
+  uint64_t gs;
+  uint64_t fs_base;
+  uint64_t gs_base;
+} GPR;
+
+struct DBG {
+  uint64_t dr[16];
+};
+
+struct UserArea {
+  GPR gpr;
+  FPR fpr;
+  DBG dbg;
+};
+
+#define DR_OFFSET(reg_index)                                                   \
+  (LLVM_EXTENSION offsetof(UserArea, dbg) +                                    \
+   LLVM_EXTENSION offsetof(DBG, dr[reg_index]))
+
+#define DECLARE_REGISTER_INFOS_X86_64_STRUCT
+#include "RegisterInfos_x86_64.h"
+#undef DECLARE_REGISTER_INFOS_X86_64_STRUCT
+
+RegisterContextZedBSD_x86_64::RegisterContextZedBSD_x86_64(
+    const ArchSpec &target_arch)
+    : lldb_private::RegisterInfoInterface(target_arch),
+      m_register_info_p(g_register_infos_x86_64),
+      m_register_count(static_cast<uint32_t>(
+          sizeof(g_register_infos_x86_64) /
+          sizeof(g_register_infos_x86_64[0]))),
+      m_user_register_count(
+          static_cast<uint32_t>(k_num_user_registers_x86_64)) {
+  assert(target_arch.GetMachine() == llvm::Triple::x86_64 &&
+         "this system runs on one architecture only");
+}
+
+size_t RegisterContextZedBSD_x86_64::GetGPRSize() const { return sizeof(GPR); }
+
+const RegisterInfo *RegisterContextZedBSD_x86_64::GetRegisterInfo() const {
+  return m_register_info_p;
+}
+
+uint32_t RegisterContextZedBSD_x86_64::GetRegisterCount() const {
+  return m_register_count;
+}
+
+uint32_t RegisterContextZedBSD_x86_64::GetUserRegisterCount() const {
+  return m_user_register_count;
+}
