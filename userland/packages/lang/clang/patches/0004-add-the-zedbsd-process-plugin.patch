+//===-- ZedBSDSignals.cpp -------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "ZedBSDSignals.h"
+
+#ifdef __ZEDBSD__
+#include <csignal>
+
+#define ADD_SIGNAL(signal_name, signal_value, ...)                             \
+  static_assert(signal_name == signal_value,                                   \
+                "Value mismatch for signal number " #signal_name);             \
+  AddSignal(signal_value, #signal_name, __VA_ARGS__)
+#define ADD_SIGCODE(signal_name, signal_value, code_name, code_value, ...)     \
+  static_assert(signal_name == signal_value,                                   \
+                "Value mismatch for signal number " #signal_name);             \
+  static_assert(code_name == code_value,                                       \
+                "Value mismatch for signal code " #code_name);                 \
+  AddSignalCode(signal_value, code_value, __VA_ARGS__)
+#else
+#define ADD_SIGNAL(signal_name, signal_value, ...)                             \
+  AddSignal(signal_value, #signal_name, __VA_ARGS__)
+#define ADD_SIGCODE(signal_name, signal_value, code_name, code_value, ...)     \
+  AddSignalCode(signal_value, code_value, __VA_ARGS__)
+#endif /* ifdef __ZEDBSD__ */
+
+using namespace lldb_private;
+
+ZedBSDSignals::ZedBSDSignals() : UnixSignals() { Reset(); }
+
+// The numbers follow the system's <signal.h>, which orders the signals
+// its own way after the first fifteen; the table is rebuilt from scratch
+// rather than patched, so that no generic number survives by accident.
+void ZedBSDSignals::Reset() {
+  m_signals.clear();
+
+  // clang-format off
+  //         SIGNO      NAME          SUPPRESS  STOP    NOTIFY  DESCRIPTION
+  //         =========  ============  ========  ======  ======  ===================================
+  ADD_SIGNAL(SIGHUP,    1,            false,    true,   true,   "hangup");
+  ADD_SIGNAL(SIGINT,    2,            true,     true,   true,   "interrupt");
+  ADD_SIGNAL(SIGQUIT,   3,            false,    true,   true,   "quit");
+  ADD_SIGNAL(SIGILL,    4,            false,    true,   true,   "illegal instruction");
+  ADD_SIGNAL(SIGTRAP,   5,            true,     true,   true,   "trace trap (not reset when caught)");
+  ADD_SIGNAL(SIGABRT,   6,            false,    true,   true,   "abort()");
+  ADD_SIGNAL(SIGVTALRM, 7,            false,    false,  false,  "virtual time alarm");
+  ADD_SIGNAL(SIGFPE,    8,            false,    true,   true,   "floating point exception");
+  ADD_SIGNAL(SIGKILL,   9,            false,    true,   true,   "kill");
+  ADD_SIGNAL(SIGBUS,    10,           false,    true,   true,   "bus error");
+  ADD_SIGNAL(SIGSEGV,   11,           false,    true,   true,   "segmentation violation");
+  ADD_SIGNAL(SIGPROF,   12,           false,    false,  false,  "profiling time alarm");
+  ADD_SIGNAL(SIGPIPE,   13,           false,    false,  false,  "write on a pipe with no one to read it");
+  ADD_SIGNAL(SIGALRM,   14,           false,    false,  false,  "alarm clock");
+  ADD_SIGNAL(SIGTERM,   15,           false,    true,   true,   "software termination signal from kill");
+  ADD_SIGNAL(SIGUSR1,   16,           false,    true,   true,   "user defined signal 1");
+  ADD_SIGNAL(SIGUSR2,   17,           false,    true,   true,   "user defined signal 2");
+  ADD_SIGNAL(SIGCHLD,   18,           false,    false,  false,  "to parent on child stop or exit");
+  ADD_SIGNAL(SIGCONT,   19,           false,    false,  true,   "continue a stopped process");
+  ADD_SIGNAL(SIGSTOP,   20,           true,     true,   true,   "sendable stop signal not from tty");
+  ADD_SIGNAL(SIGTSTP,   21,           false,    true,   true,   "stop signal from tty");
+  ADD_SIGNAL(SIGTTIN,   22,           false,    true,   true,   "to readers process group upon background tty read");
+  ADD_SIGNAL(SIGTTOU,   23,           false,    true,   true,   "to readers process group upon background tty write");
+  ADD_SIGNAL(SIGURG,    24,           false,    false,  false,  "urgent condition on IO channel");
+  ADD_SIGNAL(SIGWINCH,  25,           false,    false,  false,  "window size changes");
+  ADD_SIGNAL(SIGIO,     26,           false,    false,  false,  "input/output possible signal");
+  ADD_SIGNAL(SIGXCPU,   27,           false,    true,   true,   "exceeded CPU time limit");
+  ADD_SIGNAL(SIGXFSZ,   28,           false,    true,   true,   "exceeded file size limit");
+  ADD_SIGNAL(SIGSYS,    29,           false,    true,   true,   "bad argument to system call");
+
+  // SIGILL
+  ADD_SIGCODE(SIGILL, 4, ILL_ILLOPC, 1, "illegal opcode");
+
+  // SIGFPE
+  ADD_SIGCODE(SIGFPE, 8, FPE_INTDIV, 1, "integer divide by zero");
+
+  // SIGBUS
+  ADD_SIGCODE(SIGBUS, 10, BUS_ADRALN, 1, "invalid address alignment");
+  ADD_SIGCODE(SIGBUS, 10, BUS_ADRERR, 2, "non-existent physical address");
+
+  // SIGSEGV
+  ADD_SIGCODE(SIGSEGV, 11, SEGV_MAPERR, 1, "address not mapped to object",
+              SignalCodePrintOption::Address);
+  ADD_SIGCODE(SIGSEGV, 11, SEGV_ACCERR, 2, "invalid permissions for mapped object",
+              SignalCodePrintOption::Address);
+
+  // SIGTRAP
+  ADD_SIGCODE(SIGTRAP, 5, TRAP_BRKPT,  1, "breakpoint trap");
+  ADD_SIGCODE(SIGTRAP, 5, TRAP_TRACE,  2, "trace trap");
+  ADD_SIGCODE(SIGTRAP, 5, TRAP_HWBKPT, 3, "hardware breakpoint or watchpoint trap");
+  // clang-format on
+
+  // The real-time signals, numbered as the system numbers them.
+  for (int signo = 30; signo <= 62; ++signo) {
+    std::string name = "SIGRTMIN+" + std::to_string(signo - 30);
+    AddSignal(signo, name, false, false, false, "real time signal");
+  }
+}
