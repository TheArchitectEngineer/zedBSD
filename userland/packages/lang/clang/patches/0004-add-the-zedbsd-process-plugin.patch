+    lldb_r12_x86_64,    lldb_r13_x86_64,    lldb_r14_x86_64,
+    lldb_r15_x86_64,    lldb_rip_x86_64,    lldb_rflags_x86_64,
+    lldb_cs_x86_64,     lldb_fs_x86_64,     lldb_gs_x86_64,
+    lldb_ss_x86_64,     lldb_ds_x86_64,     lldb_es_x86_64,
+    LLDB_INVALID_REGNUM};
+
+static const RegisterSet g_reg_sets_x86_64[] = {
+    {"General Purpose Registers", "gpr",
+     (sizeof(g_gpr_regnums) / sizeof(g_gpr_regnums[0])) - 1, g_gpr_regnums},
+};
