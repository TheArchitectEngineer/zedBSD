+// The mapping flags as this system's <sys/mman.h> spells them.  They are
+// written out here rather than taken from the header, because this plugin
+// is also built on other hosts to debug this system from afar, and those
+// hosts spell the same flags differently.
+#define ZEDBSD_MAP_PRIVATE 0x0001
+#define ZEDBSD_MAP_ANONYMOUS 0x0020
+
+using namespace lldb;
+using namespace lldb_private;
+using namespace lldb_private::platform_zedbsd;
+
+LLDB_PLUGIN_DEFINE(PlatformZedBSD)
+
+static uint32_t g_initialize_count = 0;
+
+PlatformSP PlatformZedBSD::CreateInstance(bool force, const ArchSpec *arch) {
+  Log *log = GetLog(LLDBLog::Platform);
+  LLDB_LOG(log, "force = {0}, arch=({1}, {2})", force,
+           arch ? arch->GetArchitectureName() : "<null>",
+           arch ? arch->GetTriple().getTriple() : "<null>");
+
+  bool create = force;
+  if (!create && arch && arch->IsValid()) {
+    const llvm::Triple &triple = arch->GetTriple();
+    switch (triple.getOS()) {
+    case llvm::Triple::ZedBSD:
+      create = true;
+      break;
+
+#if defined(__ZEDBSD__)
+    // An unspecified OS is taken to mean this one when this is the host,
+    // because that is what an unspecified OS means on any host.
+    case llvm::Triple::OSType::UnknownOS:
+      create = !arch->TripleOSWasSpecified();
+      break;
+#endif
+    default:
+      break;
+    }
+  }
+  LLDB_LOG(log, "create = {0}", create);
+  if (create) {
+    return PlatformSP(new PlatformZedBSD(false));
+  }
+  return PlatformSP();
+}
+
+llvm::StringRef PlatformZedBSD::GetPluginDescriptionStatic(bool is_host) {
+  if (is_host)
+    return "Local zedBSD user platform plug-in.";
+  return "Remote zedBSD user platform plug-in.";
+}
+
+void PlatformZedBSD::Initialize() {
+  Platform::Initialize();
+
+  if (g_initialize_count++ == 0) {
+#if defined(__ZEDBSD__)
+    PlatformSP default_platform_sp(new PlatformZedBSD(true));
+    default_platform_sp->SetSystemArchitecture(HostInfo::GetArchitecture());
+    Platform::SetHostPlatform(default_platform_sp);
+#endif
+    PluginManager::RegisterPlugin(
+        PlatformZedBSD::GetPluginNameStatic(false),
+        PlatformZedBSD::GetPluginDescriptionStatic(false),
+        PlatformZedBSD::CreateInstance, nullptr);
+  }
+}
+
+void PlatformZedBSD::Terminate() {
+  if (g_initialize_count > 0) {
+    if (--g_initialize_count == 0) {
+      PluginManager::UnregisterPlugin(PlatformZedBSD::CreateInstance);
+    }
+  }
+
+  PlatformPOSIX::Terminate();
+}
+
+PlatformZedBSD::PlatformZedBSD(bool is_host)
+    : PlatformPOSIX(is_host) // This is the local host platform
+{
+  if (is_host) {
+    m_supported_architectures.push_back(HostInfo::GetArchitecture());
+  } else {
+    m_supported_architectures =
+        CreateArchList({llvm::Triple::x86_64}, llvm::Triple::ZedBSD);
+  }
+}
+
+std::vector<ArchSpec>
+PlatformZedBSD::GetSupportedArchitectures(const ArchSpec &process_host_arch) {
+  if (m_remote_platform_sp)
+    return m_remote_platform_sp->GetSupportedArchitectures(process_host_arch);
+  return m_supported_architectures;
+}
+
+void PlatformZedBSD::GetStatus(Stream &strm) {
+  Platform::GetStatus(strm);
+
+#if LLDB_ENABLE_POSIX
+  // The kernel is described only when this is the host; from afar the
+  // kernel here is not the one being debugged.
+  if (IsHost()) {
+    struct utsname un;
+
+    if (uname(&un))
+      return;
+
+    strm.Printf("    Kernel: %s\n", un.sysname);
+    strm.Printf("   Release: %s\n", un.release);
+    strm.Printf("   Version: %s\n", un.version);
+  }
+#endif
+}
+
+// A process on this system is debugged through lldb-server, which the
+// process plugin for this system provides.
+bool PlatformZedBSD::CanDebugProcess() { return true; }
+
+void PlatformZedBSD::CalculateTrapHandlerSymbolNames() {
+  m_trap_handlers.push_back(ConstString("__signal_restorer"));
+}
+
+MmapArgList PlatformZedBSD::GetMmapArgumentList(const ArchSpec &arch,
+                                                addr_t addr, addr_t length,
+                                                unsigned prot, unsigned flags,
+                                                addr_t fd, addr_t offset) {
+  uint64_t flags_platform = 0;
+
+  if (flags & eMmapFlagsPrivate)
+    flags_platform |= ZEDBSD_MAP_PRIVATE;
+  if (flags & eMmapFlagsAnon)
+    flags_platform |= ZEDBSD_MAP_ANONYMOUS;
+
+  MmapArgList args({addr, length, prot, flags_platform, fd, offset});
+  return args;
+}
