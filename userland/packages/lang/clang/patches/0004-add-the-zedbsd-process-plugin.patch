+//===-- NativeThreadZedBSD.cpp --------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "NativeThreadZedBSD.h"
+#include "NativeProcessZedBSD.h"
+#include "NativeRegisterContextZedBSD.h"
+
+#include "lldb/Utility/LLDBLog.h"
+#include "lldb/Utility/Log.h"
+#include "lldb/Utility/State.h"
+
+#include <sstream>
+
+using namespace lldb;
+using namespace lldb_private;
+using namespace lldb_private::process_zedbsd;
+
+NativeThreadZedBSD::NativeThreadZedBSD(NativeProcessZedBSD &process,
+                                       lldb::tid_t tid)
+    : NativeThreadProtocol(process, tid), m_state(StateType::eStateInvalid),
+      m_stop_info(),
+      m_reg_context_up(
+          NativeRegisterContextZedBSD::CreateHostNativeRegisterContextZedBSD(
+              process.GetArchitecture(), *this)) {}
+
+void NativeThreadZedBSD::SetStoppedBySignal(uint32_t signo,
+                                            const siginfo_t *info) {
+  m_state = StateType::eStateStopped;
+  m_stop_info.reason = StopReason::eStopReasonSignal;
+  m_stop_info.signo = signo;
+  m_stop_description.clear();
+  (void)info;
+}
+
+void NativeThreadZedBSD::SetStoppedByBreakpoint() {
+  m_state = StateType::eStateStopped;
+  m_stop_info.reason = StopReason::eStopReasonBreakpoint;
+  m_stop_info.signo = SIGTRAP;
+  m_stop_description.clear();
+}
+
+void NativeThreadZedBSD::SetStoppedByTrace() {
+  m_state = StateType::eStateStopped;
+  m_stop_info.reason = StopReason::eStopReasonTrace;
+  m_stop_info.signo = SIGTRAP;
+  m_stop_description.clear();
+}
+
+void NativeThreadZedBSD::SetStoppedByWatchpoint(uint32_t wp_index) {
+  std::ostringstream description;
+
+  m_state = StateType::eStateStopped;
+  m_stop_info.reason = StopReason::eStopReasonWatchpoint;
+  m_stop_info.signo = SIGTRAP;
+  description << GetRegisterContext().GetWatchpointAddress(wp_index);
+  m_stop_description = description.str();
+}
+
+void NativeThreadZedBSD::SetStoppedByExec() {
+  m_state = StateType::eStateStopped;
+  m_stop_info.reason = StopReason::eStopReasonExec;
+  m_stop_info.signo = SIGTRAP;
+  m_stop_description.clear();
+}
+
+void NativeThreadZedBSD::SetStopped() {
+  m_state = StateType::eStateStopped;
+  m_stop_info.reason = StopReason::eStopReasonNone;
+  m_stop_description.clear();
+}
+
+void NativeThreadZedBSD::SetRunning() {
+  m_state = StateType::eStateRunning;
+  m_stop_info.reason = StopReason::eStopReasonNone;
+  m_stop_description.clear();
+}
+
+void NativeThreadZedBSD::SetStepping() {
+  m_state = StateType::eStateStepping;
+  m_stop_info.reason = StopReason::eStopReasonNone;
+  m_stop_description.clear();
+}
+
+std::string NativeThreadZedBSD::GetName() { return std::string(); }
+
+lldb::StateType NativeThreadZedBSD::GetState() { return m_state; }
+
+bool NativeThreadZedBSD::GetStopReason(ThreadStopInfo &stop_info,
+                                       std::string &description) {
+  switch (m_state) {
+  case eStateStopped:
+  case eStateCrashed:
+  case eStateExited:
+  case eStateSuspended:
+  case eStateUnloaded:
+    stop_info = m_stop_info;
+    description = m_stop_description;
+    return true;
+
+  case eStateInvalid:
+  case eStateConnected:
+  case eStateAttaching:
+  case eStateLaunching:
+  case eStateRunning:
+  case eStateStepping:
+  case eStateDetached:
+    return false;
+  }
+  llvm_unreachable("unhandled thread state");
+}
+
+NativeRegisterContextZedBSD &NativeThreadZedBSD::GetRegisterContext() {
+  assert(m_reg_context_up);
+  return *m_reg_context_up;
+}
+
+Status NativeThreadZedBSD::SetWatchpoint(lldb::addr_t addr, size_t size,
+                                         uint32_t watch_flags, bool hardware) {
+  if (!hardware)
+    return Status::FromErrorString("this system watches in hardware only");
+  if (m_state == eStateLaunching)
+    return Status();
+
+  Status error = RemoveWatchpoint(addr);
+  if (error.Fail())
+    return error;
+
+  uint32_t wp_index =
+      GetRegisterContext().SetHardwareWatchpoint(addr, size, watch_flags);
+  if (wp_index == LLDB_INVALID_INDEX32)
+    return Status::FromErrorString("no debug point is free");
+  m_watchpoint_index_map.insert({addr, wp_index});
+  return Status();
+}
+
+Status NativeThreadZedBSD::RemoveWatchpoint(lldb::addr_t addr) {
+  auto wp = m_watchpoint_index_map.find(addr);
+  if (wp == m_watchpoint_index_map.end())
+    return Status();
+
+  uint32_t wp_index = wp->second;
+  m_watchpoint_index_map.erase(wp);
+  if (GetRegisterContext().ClearHardwareWatchpoint(wp_index))
+    return Status();
+  return Status::FromErrorString("the debug point could not be withdrawn");
+}
+
+Status NativeThreadZedBSD::SetHardwareBreakpoint(lldb::addr_t addr,
+                                                 size_t size) {
+  if (m_state == eStateLaunching)
+    return Status();
+
+  Status error = RemoveHardwareBreakpoint(addr);
+  if (error.Fail())
+    return error;
+
+  uint32_t bp_index = GetRegisterContext().SetHardwareBreakpoint(addr, size);
+  if (bp_index == LLDB_INVALID_INDEX32)
+    return Status::FromErrorString("no debug point is free");
+  m_hw_break_index_map.insert({addr, bp_index});
+  return Status();
+}
+
+Status NativeThreadZedBSD::RemoveHardwareBreakpoint(lldb::addr_t addr) {
+  auto bp = m_hw_break_index_map.find(addr);
+  if (bp == m_hw_break_index_map.end())
+    return Status();
+
+  uint32_t bp_index = static_cast<uint32_t>(bp->second);
+  m_hw_break_index_map.erase(bp);
+  if (GetRegisterContext().ClearHardwareBreakpoint(bp_index))
+    return Status();
+  return Status::FromErrorString("the debug point could not be withdrawn");
+}
