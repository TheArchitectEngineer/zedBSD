+// -----------------------------------------------------------------------
+// Starting and taking hold of a process
+// -----------------------------------------------------------------------
+
+llvm::Expected<std::unique_ptr<NativeProcessProtocol>>
+NativeProcessZedBSD::Manager::Launch(ProcessLaunchInfo &launch_info,
+                                     NativeDelegate &native_delegate) {
+  Log *log = GetLog(POSIXLog::Process);
+  Status status;
+
+  // The child asks to be traced and then replaces its image; the kernel
+  // stops it with the new image in place and nothing of it run, which is
+  // where a debugger wants to take hold.
+  ::pid_t pid = ProcessLauncherPosixFork()
+                    .LaunchProcess(launch_info, status)
+                    .GetProcessId();
+  LLDB_LOG(log, "pid = {0:x}", pid);
+  if (status.Fail()) {
+    LLDB_LOG(log, "failed to launch process: {0}", status);
+    return std::move(status).ToError();
+  }
+
+  int wstatus;
+  ::pid_t wpid = llvm::sys::RetryAfterSignal(-1, ::waitpid, pid, &wstatus, 0);
+  assert(wpid == pid);
+  UNUSED_IF_ASSERT_DISABLED(wpid);
+  if (!WIFSTOPPED(wstatus)) {
+    LLDB_LOG(log, "Could not sync with inferior process: wstatus={1}",
+             WaitStatus::Decode(wstatus));
+    return llvm::make_error<StringError>("Could not sync with inferior process",
+                                         llvm::inconvertibleErrorCode());
+  }
+
+  ArchSpec arch;
+  arch = HostInfo::GetArchitecture(HostInfo::eArchKindDefault);
+
+  std::unique_ptr<NativeProcessZedBSD> process_up(new NativeProcessZedBSD(
+      pid, launch_info.GetPTY().ReleasePrimaryFileDescriptor(), native_delegate,
+      arch, m_mainloop));
+
+  status = process_up->ReinitializeThreads();
+  if (status.Fail())
+    return std::move(status).ToError();
+
+  for (const auto &thread : process_up->m_threads)
+    static_cast<NativeThreadZedBSD &>(*thread).SetStoppedBySignal(SIGSTOP);
+  process_up->SetState(StateType::eStateStopped, false);
+
+  return std::move(process_up);
+}
+
+llvm::Expected<std::unique_ptr<NativeProcessProtocol>>
+NativeProcessZedBSD::Manager::Attach(lldb::pid_t pid,
+                                     NativeDelegate &native_delegate) {
+  Log *log = GetLog(POSIXLog::Process);
+  LLDB_LOG(log, "pid = {0:x}", pid);
+
+  Status status = PtraceWrapper(PT_ATTACH, pid);
+  if (status.Fail())
+    return std::move(status).ToError();
+
+  int wstatus;
+  ::pid_t wpid = llvm::sys::RetryAfterSignal(-1, ::waitpid, pid, &wstatus, 0);
+  if (wpid != static_cast<::pid_t>(pid) || !WIFSTOPPED(wstatus))
+    return llvm::make_error<StringError>("Could not sync with inferior process",
+                                         llvm::inconvertibleErrorCode());
+
+  ArchSpec arch = HostInfo::GetArchitecture(HostInfo::eArchKindDefault);
+
+  std::unique_ptr<NativeProcessZedBSD> process_up(new NativeProcessZedBSD(
+      pid, -1, native_delegate, arch, m_mainloop));
+
+  status = process_up->ReinitializeThreads();
+  if (status.Fail())
+    return std::move(status).ToError();
+
+  for (const auto &thread : process_up->m_threads)
+    static_cast<NativeThreadZedBSD &>(*thread).SetStoppedBySignal(SIGSTOP);
+  process_up->SetState(StateType::eStateStopped, false);
+
+  return std::move(process_up);
+}
+
+NativeProcessZedBSD::Extension
+NativeProcessZedBSD::Manager::GetSupportedExtensions() const {
+  return Extension::multiprocess | Extension::pass_signals |
+         Extension::auxv | Extension::siginfo_read;
+}
+
+NativeProcessZedBSD::NativeProcessZedBSD(::pid_t pid, int terminal_fd,
+                                         NativeDelegate &delegate,
+                                         const ArchSpec &arch,
+                                         MainLoop &mainloop)
+    : NativeProcessELF(pid, terminal_fd, delegate), m_arch(arch),
+      m_main_loop(mainloop) {
+  Status status;
+  m_sigchld_handle = mainloop.RegisterSignal(
+      SIGCHLD, [this](MainLoopBase &) { SigchldHandler(); }, status);
+  assert(m_sigchld_handle && status.Success());
+}
+
+// -----------------------------------------------------------------------
+// Watching the process stop and start
+// -----------------------------------------------------------------------
+
+void NativeProcessZedBSD::SigchldHandler() {
+  Log *log = GetLog(POSIXLog::Process);
+
+  int status;
+  ::pid_t wait_pid =
+      llvm::sys::RetryAfterSignal(-1, ::waitpid, GetID(), &status, WNOHANG);
+
+  if (wait_pid == 0)
+    return;
+
+  if (wait_pid == -1) {
+    Status error(errno, eErrorTypePOSIX);
+    LLDB_LOG(log, "waitpid ({0}, &status, _) failed: {1}", GetID(), error);
+    return;
+  }
+
+  WaitStatus wait_status = WaitStatus::Decode(status);
+  bool exited = wait_status.type == WaitStatus::Exit ||
+                (wait_status.type == WaitStatus::Signal &&
+                 wait_pid == static_cast<::pid_t>(GetID()));
+
+  LLDB_LOG(log, "waitpid ({0}, &status, _) => pid = {1}, status = {2}, exited "
+                "= {3}",
+           GetID(), wait_pid, wait_status, exited);
+
+  if (exited)
+    MonitorExited(wait_pid, wait_status);
+  else {
+    assert(wait_status.type == WaitStatus::Stop);
+    MonitorStopped(wait_pid, wait_status.status);
+  }
+}
+
+void NativeProcessZedBSD::MonitorExited(lldb::pid_t pid, WaitStatus status) {
+  Log *log = GetLog(POSIXLog::Process);
+
+  LLDB_LOG(log, "got exit signal({0}) , pid = {1}", status, pid);
+
+  m_threads.clear();
+  SetExitStatus(status, true);
+  m_sigchld_handle.reset();
+}
+
+void NativeProcessZedBSD::MonitorStopped(lldb::pid_t pid, int signal) {
+  Log *log = GetLog(POSIXLog::Process);
+
+  Status error = ReinitializeThreads();
+  if (error.Fail()) {
+    SetState(StateType::eStateInvalid);
+    return;
+  }
+
+  LLDB_LOG(log, "stopped, pid = {0}, signal = {1}", pid, signal);
+
+  for (const auto &thread : m_threads) {
+    auto &native_thread = static_cast<NativeThreadZedBSD &>(*thread);
+    SetStopReasonFromStopState(native_thread, signal);
+  }
+  SetState(StateType::eStateStopped, true);
+}
+
+// The kernel says why a process stopped: which of the three kinds of trap
+// it was, or that a signal was about to be delivered.
+void NativeProcessZedBSD::SetStopReasonFromStopState(
+    NativeThreadZedBSD &thread, int signal) {
+  struct ptrace_state state;
+
+  ::memset(&state, 0, sizeof(state));
+  if (signal != SIGTRAP ||
+      PtraceWrapper(PT_GET_PROCESS_STATE, GetID(), &state).Fail()) {
+    thread.SetStoppedBySignal(signal);
+    return;
+  }
+
+  switch (state.pe_report_event) {
+  case PTRACE_STOP_BREAKPOINT:
+    thread.SetStoppedByBreakpoint();
+    FixupBreakpointPCAsNeeded(thread);
+    break;
+  case PTRACE_STOP_STEP:
+    thread.SetStoppedByTrace();
+    break;
+  case PTRACE_STOP_WATCHPOINT: {
+    // Which point matched is decided by the address the stop carried,
+    // because that is what the processor reported having matched.
+    uint32_t wp_index = LLDB_INVALID_INDEX32;
+    lldb::addr_t hit = LLDB_INVALID_ADDRESS;
+    thread.GetRegisterContext().GetWatchpointHitIndex(wp_index, hit);
+    if (wp_index != LLDB_INVALID_INDEX32)
+      thread.SetStoppedByWatchpoint(wp_index);
+    else
+      thread.SetStoppedBySignal(signal);
+    break;
+  }
+  case PTRACE_STOP_EXEC:
+    thread.SetStoppedByExec();
+    break;
+  default:
+    thread.SetStoppedBySignal(signal);
+    break;
+  }
+}
+
+// -----------------------------------------------------------------------
+// Letting the process run again
+// -----------------------------------------------------------------------
+
+Status NativeProcessZedBSD::Resume(const ResumeActionList &resume_actions) {
+  Log *log = GetLog(POSIXLog::Process);
+  LLDB_LOG(log, "pid {0}", GetID());
+
+  Status error = ReinitializeThreads();
+  if (error.Fail())
+    return error;
+
+  // One thread decides how the process goes on, because the kernel resumes
+  // a process rather than a thread: the first action that says to run is
+  // the one taken, and stepping wins over running.
+  int signal = 0;
+  bool step = false;
+  bool resume = false;
+
+  for (const auto &abs_thread : m_threads) {
+    auto &thread = static_cast<NativeThreadZedBSD &>(*abs_thread);
+    const ResumeAction *const action =
+        resume_actions.GetActionForThread(thread.GetID(), true);
+    if (action == nullptr)
+      continue;
+
+    switch (action->state) {
+    case eStateRunning:
+      resume = true;
+      if (action->signal > 0 && action->signal != LLDB_INVALID_SIGNAL_NUMBER)
+        signal = action->signal;
+      thread.SetRunning();
+      break;
+    case eStateStepping:
+      resume = true;
+      step = true;
+      if (action->signal > 0 && action->signal != LLDB_INVALID_SIGNAL_NUMBER)
+        signal = action->signal;
+      thread.SetStepping();
+      break;
+    case eStateSuspended:
+    case eStateStopped:
+      break;
+    default:
+      return Status::FromErrorStringWithFormat(
+          "NativeProcessZedBSD::%s (): unexpected state %s specified for pid "
+          "%" PRIu64 ", tid %" PRIu64,
+          __FUNCTION__, StateAsCString(action->state), GetID(),
+          thread.GetID());
+    }
+  }
+
+  if (!resume)
+    return Status();
+
+  error = PtraceWrapper(step ? PT_STEP : PT_CONTINUE, GetID(), nullptr, signal);
+  if (error.Success())
+    SetState(eStateRunning, true);
+  return error;
+}
+
+Status NativeProcessZedBSD::Halt() { return StopProcess(GetID()); }
+
+Status NativeProcessZedBSD::Detach() {
+  Status error;
+
+  if (GetID() == LLDB_INVALID_PROCESS_ID)
+    return error;
+  return PtraceWrapper(PT_DETACH, GetID());
+}
+
+Status NativeProcessZedBSD::Signal(int signo) {
+  Status error;
+
+  if (kill(GetID(), signo))
+    error = Status(errno, eErrorTypePOSIX);
+  return error;
+}
+
+Status NativeProcessZedBSD::Interrupt() { return StopProcess(GetID()); }
+
+Status NativeProcessZedBSD::Kill() {
+  Log *log = GetLog(POSIXLog::Process);
+  LLDB_LOG(log, "pid {0}", GetID());
+
+  switch (m_state) {
+  case StateType::eStateInvalid:
+  case StateType::eStateExited:
+  case StateType::eStateCrashed:
+  case StateType::eStateDetached:
+  case StateType::eStateUnloaded:
+    return Status();
+
+  case StateType::eStateConnected:
+  case StateType::eStateAttaching:
+  case StateType::eStateLaunching:
+  case StateType::eStateStopped:
+  case StateType::eStateRunning:
+  case StateType::eStateStepping:
+  case StateType::eStateSuspended:
+    break;
+  }
+
+  if (kill(GetID(), SIGKILL))
+    return Status(errno, eErrorTypePOSIX);
+  return Status();
+}
+
+// -----------------------------------------------------------------------
+// Reading and writing the stopped process
+// -----------------------------------------------------------------------
+
+Status NativeProcessZedBSD::ReadMemory(lldb::addr_t addr, void *buf,
+                                       size_t size, size_t &bytes_read) {
+  struct ptrace_io_desc io;
+
+  bytes_read = 0;
+  io.piod_op = PIOD_READ_D;
+  io.piod_offs = reinterpret_cast<void *>(addr);
+  io.piod_addr = buf;
+  io.piod_len = size;
+
+  Status error = PtraceWrapper(PT_IO, GetID(), &io);
+  if (error.Fail())
+    return error;
+  bytes_read = size;
+  return error;
+}
+
+Status NativeProcessZedBSD::WriteMemory(lldb::addr_t addr, const void *buf,
+                                        size_t size, size_t &bytes_written) {
+  struct ptrace_io_desc io;
+
+  bytes_written = 0;
+
+  // A debugger writes into text as readily as into data, and the kernel
+  // is told which, because only one of the two may need the instruction
+  // cache brought up to date afterwards.
+  io.piod_op = PIOD_WRITE_I;
+  io.piod_offs = reinterpret_cast<void *>(addr);
+  io.piod_addr = const_cast<void *>(buf);
+  io.piod_len = size;
+
+  Status error = PtraceWrapper(PT_IO, GetID(), &io);
+  if (error.Fail())
+    return error;
+  bytes_written = size;
+  return error;
+}
+
+Status NativeProcessZedBSD::SetBreakpoint(lldb::addr_t addr, uint32_t size,
+                                          bool hardware) {
+  if (hardware)
+    return SetHardwareBreakpoint(addr, size);
+  return SetSoftwareBreakpoint(addr, size);
+}
+
+// -----------------------------------------------------------------------
+// What is loaded
+// -----------------------------------------------------------------------
+
+lldb::addr_t NativeProcessZedBSD::GetSharedLibraryInfoAddress() {
+  if (m_shared_library_info_address != LLDB_INVALID_ADDRESS)
+    return m_shared_library_info_address;
+
+  // The executable's own dynamic section says where the loader put the
+  // structure; the shared base of this class knows how to find it from
+  // the program headers the auxiliary vector names.
+  m_shared_library_info_address =
+      GetELFImageInfoAddress<llvm::ELF::Elf64_Ehdr, llvm::ELF::Elf64_Phdr,
+                             llvm::ELF::Elf64_Dyn>();
+  return m_shared_library_info_address;
+}
+
+Status NativeProcessZedBSD::GetLoadedModuleFileSpec(const char *module_path,
+                                                    FileSpec &file_spec) {
+  return Status::FromErrorStringWithFormat("Module file (%s) not found",
+                                           module_path);
+}
+
+Status NativeProcessZedBSD::GetFileLoadAddress(const llvm::StringRef &file_name,
+                                               lldb::addr_t &load_addr) {
+  load_addr = LLDB_INVALID_ADDRESS;
+  return Status();
+}
+
+// The kernel keeps the vector where exec left it and hands it out by
+// offset; one read of a generous size gets all of it, and the length
+// that comes back says how much that was.
+llvm::ErrorOr<std::unique_ptr<llvm::MemoryBuffer>>
+NativeProcessZedBSD::GetAuxvData() const {
+  size_t auxv_size = 64 * 2 * sizeof(uint64_t);
+
+  llvm::ErrorOr<std::unique_ptr<llvm::WritableMemoryBuffer>> buf =
+      llvm::WritableMemoryBuffer::getNewMemBuffer(auxv_size);
+
+  struct ptrace_io_desc io;
+  io.piod_op = PIOD_READ_AUXV;
+  io.piod_offs = 0;
+  io.piod_addr = static_cast<void *>(buf.get()->getBufferStart());
+  io.piod_len = auxv_size;
+
+  Status error = PtraceWrapper(PT_IO, GetID(), &io);
+  if (error.Fail())
+    return std::error_code(error.GetError(), std::generic_category());
+  if (io.piod_len < 1)
+    return std::error_code(ECANCELED, std::generic_category());
+
+  return llvm::MemoryBuffer::getMemBufferCopy(
+      llvm::StringRef(buf.get()->getBufferStart(), io.piod_len));
+}
+
+// -----------------------------------------------------------------------
+// Threads
+// -----------------------------------------------------------------------
+
+bool NativeProcessZedBSD::HasThreadNoLock(lldb::tid_t thread_id) {
+  for (const auto &thread : m_threads) {
+    if (thread->GetID() == thread_id)
+      return true;
+  }
+  return false;
+}
+
+NativeThreadZedBSD &NativeProcessZedBSD::AddThread(lldb::tid_t thread_id) {
+  assert(!HasThreadNoLock(thread_id) &&
+         "attempted to add a thread by an identifier the process already has");
+
+  if (m_threads.empty())
+    SetCurrentThreadID(thread_id);
+  m_threads.push_back(std::make_unique<NativeThreadZedBSD>(*this, thread_id));
+  return static_cast<NativeThreadZedBSD &>(*m_threads.back());
+}
+
+size_t NativeProcessZedBSD::UpdateThreads() { return m_threads.size(); }
+
+Status NativeProcessZedBSD::ReinitializeThreads() {
+  // The kernel reports the threads a process has one after another, and
+  // the list is rebuilt from that rather than kept in step with it: a
+  // stopped process is not creating threads while it is being asked.
+  std::vector<lldb::tid_t> current;
+  struct ptrace_thread_state state;
+
+  ::memset(&state, 0, sizeof(state));
+  Status error = PtraceWrapper(PT_GET_THREAD_FIRST, GetID(), &state);
+  while (error.Success()) {
+    current.push_back(static_cast<lldb::tid_t>(state.pts_thread));
+    error = PtraceWrapper(PT_GET_THREAD_NEXT, GetID(), &state);
+  }
+
+  // The end of the list is not a failure; nothing else is expected here.
+  if (current.empty())
+    current.push_back(static_cast<lldb::tid_t>(GetID()));
+
+  lldb::tid_t current_thread = GetCurrentThreadID();
+  m_threads.clear();
+  for (lldb::tid_t tid : current)
+    AddThread(tid);
+  if (std::find(current.begin(), current.end(), current_thread) !=
+      current.end())
+    SetCurrentThreadID(current_thread);
+  return Status();
+}
+
+// -----------------------------------------------------------------------
+// The one call into the kernel
+// -----------------------------------------------------------------------
+
+Status NativeProcessZedBSD::StopProcess(lldb::pid_t pid) {
+  if (kill(pid, SIGSTOP))
+    return Status(errno, eErrorTypePOSIX);
+  return Status();
+}
+
+Status NativeProcessZedBSD::PtraceWrapper(int req, lldb::pid_t pid, void *addr,
+                                          int data, int *result) {
+  Status error;
+  int ret;
+
+  errno = 0;
+  ret = ptrace(req, static_cast<::pid_t>(pid), addr, data);
+
+  if (ret == -1 && errno != 0)
+    error = Status(errno, eErrorTypePOSIX);
+  if (result != nullptr)
+    *result = ret;
+
+  Log *log = GetLog(POSIXLog::Ptrace);
+  LLDB_LOG(log, "ptrace({0}, {1}, {2}, {3})={4:x}", req, pid, addr, data, ret);
+  return error;
+}
