+std::unique_ptr<NativeRegisterContextZedBSD>
+NativeRegisterContextZedBSD::CreateHostNativeRegisterContextZedBSD(
+    const ArchSpec &target_arch, NativeThreadProtocol &native_thread) {
+  return std::make_unique<NativeRegisterContextZedBSD_x86_64>(target_arch,
+                                                              native_thread);
+}
+
+NativeRegisterContextZedBSD_x86_64::NativeRegisterContextZedBSD_x86_64(
+    const ArchSpec &target_arch, NativeThreadProtocol &native_thread)
+    : NativeRegisterContextRegisterInfo(
+          native_thread, new RegisterContextZedBSD_x86_64(target_arch)),
+      NativeRegisterContextZedBSD(native_thread), m_point_count(0) {
+  ::memset(&m_user, 0, sizeof(m_user));
+  m_points.fill({});
+  m_point_hit.fill(LLDB_INVALID_ADDRESS);
+}
+
+uint32_t NativeRegisterContextZedBSD_x86_64::GetRegisterSetCount() const {
+  return sizeof(g_reg_sets_x86_64) / sizeof(g_reg_sets_x86_64[0]);
+}
+
+const RegisterSet *
+NativeRegisterContextZedBSD_x86_64::GetRegisterSet(uint32_t set_index) const {
+  if (set_index >= GetRegisterSetCount())
+    return nullptr;
+  return &g_reg_sets_x86_64[set_index];
+}
+
+uint32_t NativeRegisterContextZedBSD_x86_64::GetUserRegisterCount() const {
+  uint32_t count = 0;
+  for (uint32_t set = 0; set < GetRegisterSetCount(); ++set)
+    count += GetRegisterSet(set)->num_registers;
+  return count;
+}
+
+bool NativeRegisterContextZedBSD_x86_64::IsGPR(uint32_t reg_index) const {
+  return reg_index <= k_last_gpr_x86_64;
+}
+
+bool NativeRegisterContextZedBSD_x86_64::IsFPR(uint32_t reg_index) const {
+  return reg_index >= k_first_fpr_x86_64 && reg_index <= k_last_fpr_x86_64;
+}
+
+// The kernel reports the registers it keeps; what the shared description
+// names but the system does not keep is reported as zero.
+Status NativeRegisterContextZedBSD_x86_64::ReadGPR() {
+  struct reg regs;
+  Status error;
+
+  ::memset(&regs, 0, sizeof(regs));
+  error = DoRegisterRequest(PT_GETREGS, &regs,
+                            static_cast<int>(m_thread.GetID()));
+  if (error.Fail())
+    return error;
+
+  m_user.gpr.rax = regs.r_rax;
+  m_user.gpr.rbx = regs.r_rbx;
+  m_user.gpr.rcx = regs.r_rcx;
+  m_user.gpr.rdx = regs.r_rdx;
+  m_user.gpr.rsi = regs.r_rsi;
+  m_user.gpr.rdi = regs.r_rdi;
+  m_user.gpr.rbp = regs.r_rbp;
+  m_user.gpr.rsp = regs.r_rsp;
+  m_user.gpr.r8 = regs.r_r8;
+  m_user.gpr.r9 = regs.r_r9;
+  m_user.gpr.r10 = regs.r_r10;
+  m_user.gpr.r11 = regs.r_r11;
+  m_user.gpr.r12 = regs.r_r12;
+  m_user.gpr.r13 = regs.r_r13;
+  m_user.gpr.r14 = regs.r_r14;
+  m_user.gpr.r15 = regs.r_r15;
+  m_user.gpr.rip = regs.r_rip;
+  m_user.gpr.rflags = regs.r_rflags;
+  m_user.gpr.cs = regs.r_cs;
+  m_user.gpr.ss = regs.r_ss;
+  m_user.gpr.ds = 0;
+  m_user.gpr.es = 0;
+  m_user.gpr.fs = 0;
+  m_user.gpr.gs = 0;
+  m_user.gpr.fs_base = regs.r_fs_base;
+  m_user.gpr.gs_base = regs.r_gs_base;
+  return error;
+}
+
+Status NativeRegisterContextZedBSD_x86_64::WriteGPR() {
+  struct reg regs;
+
+  ::memset(&regs, 0, sizeof(regs));
+  regs.r_rax = m_user.gpr.rax;
+  regs.r_rbx = m_user.gpr.rbx;
+  regs.r_rcx = m_user.gpr.rcx;
+  regs.r_rdx = m_user.gpr.rdx;
+  regs.r_rsi = m_user.gpr.rsi;
+  regs.r_rdi = m_user.gpr.rdi;
+  regs.r_rbp = m_user.gpr.rbp;
+  regs.r_rsp = m_user.gpr.rsp;
+  regs.r_r8 = m_user.gpr.r8;
+  regs.r_r9 = m_user.gpr.r9;
+  regs.r_r10 = m_user.gpr.r10;
+  regs.r_r11 = m_user.gpr.r11;
+  regs.r_r12 = m_user.gpr.r12;
+  regs.r_r13 = m_user.gpr.r13;
+  regs.r_r14 = m_user.gpr.r14;
+  regs.r_r15 = m_user.gpr.r15;
+  regs.r_rip = m_user.gpr.rip;
+  regs.r_rflags = m_user.gpr.rflags;
+  regs.r_cs = m_user.gpr.cs;
+  regs.r_ss = m_user.gpr.ss;
+  regs.r_fs_base = m_user.gpr.fs_base;
+  regs.r_gs_base = m_user.gpr.gs_base;
+  return DoRegisterRequest(PT_SETREGS, &regs,
+                           static_cast<int>(m_thread.GetID()));
+}
+
+// The processor writes the x87 and the vector state out together; the
+// system reports them as two, and they are put back together here in the
+// one layout the shared description reads.
+Status NativeRegisterContextZedBSD_x86_64::ReadFPR() {
+  struct fpreg fpregs;
+  struct xmmreg xmmregs;
+  Status error;
+
+  ::memset(&fpregs, 0, sizeof(fpregs));
+  ::memset(&xmmregs, 0, sizeof(xmmregs));
+  error = DoRegisterRequest(PT_GETFPREGS, &fpregs,
+                            static_cast<int>(m_thread.GetID()));
+  if (error.Fail())
+    return error;
+  error = DoRegisterRequest(PT_GETXMMREGS, &xmmregs,
+                            static_cast<int>(m_thread.GetID()));
+  if (error.Fail())
+    return error;
+
+  ::memset(&m_user.fpr, 0, sizeof(m_user.fpr));
+  m_user.fpr.fxsave.fctrl = fpregs.fp_control;
+  m_user.fpr.fxsave.fstat = fpregs.fp_status;
+  m_user.fpr.fxsave.ftag = fpregs.fp_tag;
+  m_user.fpr.fxsave.fop = fpregs.fp_opcode;
+  m_user.fpr.fxsave.ptr.x86_64.fip = fpregs.fp_instruction_pointer;
+  m_user.fpr.fxsave.ptr.x86_64.fdp = fpregs.fp_data_pointer;
+  m_user.fpr.fxsave.mxcsr = xmmregs.xmm_control;
+  m_user.fpr.fxsave.mxcsrmask = xmmregs.xmm_control_mask;
+  ::memcpy(m_user.fpr.fxsave.stmm, fpregs.fp_stack,
+           sizeof(m_user.fpr.fxsave.stmm));
+  ::memcpy(m_user.fpr.fxsave.xmm, xmmregs.xmm_register,
+           sizeof(m_user.fpr.fxsave.xmm));
+  return error;
+}
+
+Status NativeRegisterContextZedBSD_x86_64::WriteFPR() {
+  struct fpreg fpregs;
+  struct xmmreg xmmregs;
+  Status error;
+
+  ::memset(&fpregs, 0, sizeof(fpregs));
+  ::memset(&xmmregs, 0, sizeof(xmmregs));
+  fpregs.fp_control = m_user.fpr.fxsave.fctrl;
+  fpregs.fp_status = m_user.fpr.fxsave.fstat;
+  fpregs.fp_tag = m_user.fpr.fxsave.ftag;
+  fpregs.fp_opcode = m_user.fpr.fxsave.fop;
+  fpregs.fp_instruction_pointer = m_user.fpr.fxsave.ptr.x86_64.fip;
+  fpregs.fp_data_pointer = m_user.fpr.fxsave.ptr.x86_64.fdp;
+  ::memcpy(fpregs.fp_stack, m_user.fpr.fxsave.stmm, sizeof(fpregs.fp_stack));
+  xmmregs.xmm_control = m_user.fpr.fxsave.mxcsr;
+  xmmregs.xmm_control_mask = m_user.fpr.fxsave.mxcsrmask;
+  ::memcpy(xmmregs.xmm_register, m_user.fpr.fxsave.xmm,
+           sizeof(xmmregs.xmm_register));
+
+  error = DoRegisterRequest(PT_SETFPREGS, &fpregs,
+                            static_cast<int>(m_thread.GetID()));
+  if (error.Fail())
+    return error;
+  return DoRegisterRequest(PT_SETXMMREGS, &xmmregs,
+                           static_cast<int>(m_thread.GetID()));
+}
+
+Status
+NativeRegisterContextZedBSD_x86_64::ReadRegister(const RegisterInfo *reg_info,
+                                                 RegisterValue &reg_value) {
+  Status error;
+
+  if (reg_info == nullptr)
+    return Status::FromErrorString("register information is missing");
+
+  const uint32_t reg = reg_info->kinds[lldb::eRegisterKindLLDB];
+  if (reg == LLDB_INVALID_REGNUM)
+    return Status::FromErrorString("this register is not in the set");
+
+  if (IsGPR(reg))
+    error = ReadGPR();
+  else if (IsFPR(reg))
+    error = ReadFPR();
+  else
+    return Status::FromErrorString("this register is not one of the two sets");
+  if (error.Fail())
+    return error;
+
+  reg_value.SetBytes(reinterpret_cast<const uint8_t *>(&m_user) +
+                         reg_info->byte_offset,
+                     reg_info->byte_size, endian::InlHostByteOrder());
+  return error;
+}
+
+Status NativeRegisterContextZedBSD_x86_64::WriteRegister(
+    const RegisterInfo *reg_info, const RegisterValue &reg_value) {
+  Status error;
+
+  if (reg_info == nullptr)
+    return Status::FromErrorString("register information is missing");
+
+  const uint32_t reg = reg_info->kinds[lldb::eRegisterKindLLDB];
+  if (reg == LLDB_INVALID_REGNUM)
+    return Status::FromErrorString("this register is not in the set");
+
+  // The whole set is read, the one register changed, and the whole set
+  // written: the system moves a set at a time, not a register.
+  if (IsGPR(reg))
+    error = ReadGPR();
+  else if (IsFPR(reg))
+    error = ReadFPR();
+  else
+    return Status::FromErrorString("this register is not one of the two sets");
+  if (error.Fail())
+    return error;
+
+  ::memcpy(reinterpret_cast<uint8_t *>(&m_user) + reg_info->byte_offset,
+           reg_value.GetBytes(), reg_info->byte_size);
+
+  if (IsGPR(reg))
+    return WriteGPR();
+  return WriteFPR();
+}
+
+Status NativeRegisterContextZedBSD_x86_64::ReadAllRegisterValues(
+    lldb::WritableDataBufferSP &data_sp) {
+  Status error;
+
+  error = ReadGPR();
+  if (error.Fail())
+    return error;
+  error = ReadFPR();
+  if (error.Fail())
+    return error;
+
+  data_sp = std::make_shared<DataBufferHeap>(sizeof(m_user), 0);
+  ::memcpy(data_sp->GetBytes(), &m_user, sizeof(m_user));
+  return error;
+}
+
+Status NativeRegisterContextZedBSD_x86_64::WriteAllRegisterValues(
+    const lldb::DataBufferSP &data_sp) {
+  Status error;
+
+  if (!data_sp || data_sp->GetByteSize() != sizeof(m_user))
+    return Status::FromErrorString("the saved registers are not this set");
+  ::memcpy(&m_user, data_sp->GetBytes(), sizeof(m_user));
+
+  error = WriteGPR();
+  if (error.Fail())
+    return error;
+  return WriteFPR();
+}
+
+llvm::Error NativeRegisterContextZedBSD_x86_64::CopyHardwareWatchpointsFrom(
+    NativeRegisterContextZedBSD &source) {
+  auto &from = static_cast<NativeRegisterContextZedBSD_x86_64 &>(source);
+
+  m_points = from.m_points;
+  m_point_count = from.m_point_count;
+  Status error = WriteDebugPoints();
+  if (error.Fail())
+    return error.takeError();
+  return llvm::Error::success();
+}
+
+// The whole set of points is given to the kernel at once, because the
+// processor decides for itself whether a particular combination fits.
+Status NativeRegisterContextZedBSD_x86_64::WriteDebugPoints() {
+  struct ptrace_debug_points points;
+
+  ::memset(&points, 0, sizeof(points));
+  points.pdps_thread = static_cast<int>(m_thread.GetID());
+  points.pdps_count = m_point_count;
+  for (unsigned index = 0; index < m_point_count; ++index)
+    points.pdps_point[index] = m_points[index];
+  return DoRegisterRequest(PT_SET_DEBUG_POINTS, &points, 0);
+}
+
+uint32_t NativeRegisterContextZedBSD_x86_64::NumSupportedHardwareBreakpoints() {
+  return PTRACE_DEBUG_POINT_MAX;
+}
+
+Status NativeRegisterContextZedBSD_x86_64::SetHardwareBreakpoint(
+    lldb::addr_t addr, size_t size) {
+  if (m_point_count >= m_points.size())
+    return Status::FromErrorString("no debug point is free");
+  m_points[m_point_count].pdp_address = addr;
+  m_points[m_point_count].pdp_length = 1;
+  m_points[m_point_count].pdp_kind = PTRACE_DEBUG_EXECUTE;
+  ++m_point_count;
+  Status error = WriteDebugPoints();
+  if (error.Fail())
+    --m_point_count;
+  return error;
+}
+
+bool NativeRegisterContextZedBSD_x86_64::ClearHardwareBreakpoint(
+    uint32_t hw_idx) {
+  if (hw_idx >= m_point_count)
+    return false;
+  for (unsigned index = hw_idx; index + 1 < m_point_count; ++index)
+    m_points[index] = m_points[index + 1];
+  --m_point_count;
+  return WriteDebugPoints().Success();
+}
+
+uint32_t NativeRegisterContextZedBSD_x86_64::NumSupportedHardwareWatchpoints() {
+  return PTRACE_DEBUG_POINT_MAX;
+}
+
+uint32_t NativeRegisterContextZedBSD_x86_64::SetHardwareWatchpoint(
+    lldb::addr_t addr, size_t size, uint32_t watch_flags) {
+  if (m_point_count >= m_points.size())
+    return LLDB_INVALID_INDEX32;
+
+  unsigned kind;
+  switch (watch_flags) {
+  case 0x1:
+    kind = PTRACE_DEBUG_READ;
+    break;
+  case 0x2:
+    kind = PTRACE_DEBUG_WRITE;
+    break;
+  default:
+    kind = PTRACE_DEBUG_ACCESS;
+    break;
+  }
+  m_points[m_point_count].pdp_address = addr;
+  m_points[m_point_count].pdp_length = static_cast<unsigned>(size);
+  m_points[m_point_count].pdp_kind = kind;
+  ++m_point_count;
+  if (WriteDebugPoints().Fail()) {
+    --m_point_count;
+    return LLDB_INVALID_INDEX32;
+  }
+  return m_point_count - 1;
+}
+
+bool NativeRegisterContextZedBSD_x86_64::ClearHardwareWatchpoint(
+    uint32_t wp_index) {
+  return ClearHardwareBreakpoint(wp_index);
+}
+
+Status NativeRegisterContextZedBSD_x86_64::ClearAllHardwareWatchpoints() {
+  m_point_count = 0;
+  return WriteDebugPoints();
+}
+
+lldb::addr_t
+NativeRegisterContextZedBSD_x86_64::GetWatchpointAddress(uint32_t wp_index) {
+  if (wp_index >= m_point_count)
+    return LLDB_INVALID_ADDRESS;
+  return m_points[wp_index].pdp_address;
+}
+
+lldb::addr_t
+NativeRegisterContextZedBSD_x86_64::GetWatchpointHitAddress(
+    uint32_t wp_index) {
+  if (wp_index >= m_point_hit.size())
+    return LLDB_INVALID_ADDRESS;
+  return m_point_hit[wp_index];
+}
+
+Status NativeRegisterContextZedBSD_x86_64::GetWatchpointHitIndex(
+    uint32_t &wp_index, lldb::addr_t trap_addr) {
+  // The stop reported the address that matched, so the point it belongs to
+  // is the one watching that address.
+  for (unsigned index = 0; index < m_point_count; ++index) {
+    const lldb::addr_t start = m_points[index].pdp_address;
+    const lldb::addr_t end = start + m_points[index].pdp_length;
+    if (m_points[index].pdp_kind != PTRACE_DEBUG_EXECUTE &&
+        trap_addr >= start && trap_addr < end) {
+      m_point_hit[index] = trap_addr;
+      wp_index = index;
+      return Status();
+    }
+  }
+  wp_index = LLDB_INVALID_INDEX32;
+  return Status();
+}
