+#include "lldb/Host/Host.h"
+#include "lldb/Host/HostInfo.h"
+#include "lldb/Utility/ProcessInfo.h"
+#include "lldb/Utility/Status.h"
+
+#include <cstring>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/types.h>
+#include <uapi/system.h>
+#include <unistd.h>
+
+using namespace lldb;
+using namespace lldb_private;
+
+// The system device describes one process per call, the first whose
+// identifier follows the one handed in, which is how a caller walks the
+// whole table and how it asks after one process in particular.
+static bool NextProcess(int device, int32_t after, struct process_info &info) {
+  memset(&info, 0, sizeof(info));
+  info.pid = after;
+  if (::ioctl(device, KERN_SYSTEM_GET_PROCESS, &info) != 0)
+    return false;
+  if (info.version != KERN_SYSTEM_PROCESS_INFO_VERSION ||
+      info.struct_size != sizeof(info))
+    return false;
+  info.command[sizeof(info.command) - 1] = '\0';
+  return true;
+}
+
+static void FillProcessInfo(const struct process_info &info,
+                            ProcessInstanceInfo &process_info) {
+  process_info.SetProcessID(info.pid);
+  process_info.SetParentProcessID(info.ppid);
+  process_info.SetProcessGroupID(info.process_group);
+  process_info.SetProcessSessionID(info.session);
+  process_info.SetUserID(info.uid);
+  process_info.SetEffectiveUserID(info.uid);
+  process_info.SetGroupID(info.gid);
+  process_info.SetEffectiveGroupID(info.gid);
+  process_info.GetArchitecture() = HostInfo::GetArchitecture();
+  // The command is what the process was started as; when that was a path
+  // it also says which file it runs.
+  if (info.command[0] != '\0') {
+    process_info.GetExecutableFile().SetFile(info.command,
+                                             FileSpec::Style::native);
+    process_info.GetArguments().Clear();
+    process_info.GetArguments().AppendArgument(info.command);
+  }
+}
+
+uint32_t Host::FindProcessesImpl(const ProcessInstanceInfoMatch &match_info,
+                                 ProcessInstanceInfoList &process_infos) {
+  int device = ::open("/dev/system", O_RDONLY | O_CLOEXEC);
+  if (device < 0)
+    return 0;
+
+  struct process_info info;
+  int32_t cursor = -1;
+  while (NextProcess(device, cursor, info)) {
+    cursor = info.pid;
+    ProcessInstanceInfo process_info;
+    FillProcessInfo(info, process_info);
+    if (match_info.Matches(process_info))
+      process_infos.push_back(process_info);
+  }
+  ::close(device);
+  return process_infos.size();
+}
+
+bool Host::GetProcessInfo(lldb::pid_t pid, ProcessInstanceInfo &process_info) {
+  process_info.Clear();
+  if (pid == LLDB_INVALID_PROCESS_ID || pid == 0)
+    return false;
+
+  int device = ::open("/dev/system", O_RDONLY | O_CLOEXEC);
+  if (device < 0)
+    return false;
+
+  struct process_info info;
+  bool found = NextProcess(device, (int32_t)pid - 1, info) &&
+               info.pid == (int32_t)pid;
+  ::close(device);
+  if (!found)
+    return false;
+
+  FillProcessInfo(info, process_info);
+  return true;
+}
+
+Status Host::ShellExpandArguments(ProcessLaunchInfo &launch_info) {
+  return Status::FromErrorString("unimplemented");
+}
