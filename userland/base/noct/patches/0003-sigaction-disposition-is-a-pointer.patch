zedBSD: the sigaction disposition is a function pointer

include/uapi/signal.h gives struct sigaction the POSIX union, so sa_handler is
void (*)(int) on zedBSD as well and the integer cast no longer compiles.  With
the union in place the zedBSD arm is the same as every other target's.

--- a/src/api/api-term-ansi.c
+++ b/src/api/api-term-ansi.c
@@ -758,11 +758,7 @@
 	/* Installs the deferred resize handler. */
 	memset(&sa, 0, sizeof(sa));
-#if defined(NOCT_TARGET_ZEDBSD)
-	sa.sa_handler = (uint64_t)(uintptr_t)on_sigwinch;
-#else
 	sa.sa_handler = on_sigwinch;
-#endif
 	(void)sigaction(SIGWINCH, &sa, NULL);
 
 	/* Enters the alternate screen and extended key mode. */
 	(void)write(STDOUT_FILENO, enter_seq, sizeof(enter_seq) - 1);

--- a/src/cli/cli-repl.c
+++ b/src/cli/cli-repl.c
@@ -251,11 +251,7 @@
 		struct sigaction action;
 
 		memset(&action, 0, sizeof(action));
-#if defined(NOCT_TARGET_ZEDBSD)
-		action.sa_handler = (uint64_t)(uintptr_t)repl_interrupt_handler;
-#else
 		action.sa_handler = repl_interrupt_handler;
-#endif
 		sigemptyset(&action.sa_mask);
 		if (sigaction(SIGINT, &action, &repl_old_action) != 0)
 			return false;

