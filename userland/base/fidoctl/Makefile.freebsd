# zedBSD; Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
# The independent FreeBSD build of fidoctl (ws161-p006): libpasskey's sources with its FreeBSD layer (os-freebsd.c,
# hidraw(4)'s raw HID nodes /dev/hidrawN) built into it, the cryptography the base system's OpenSSL libcrypto until
# WS172 p005 replaces it.
KEILAND_FREEBSD_FIDOCTL_SOURCES := userland/base/fidoctl/main.c \
	userland/base/libpasskey/cbor.c \
	userland/base/libpasskey/crypto-openssl.c \
	userland/base/libpasskey/ctap2.c \
	userland/base/libpasskey/descriptor.c \
	userland/base/libpasskey/hid.c \
	userland/base/libpasskey/os-posix.c \
	userland/base/libpasskey/os-freebsd.c \
	userland/base/libpasskey/pin.c \
	userland/base/libpasskey/transport-nfc.c \
	userland/base/libpasskey/verify.c
$(eval $(call KEILAND_FREEBSD_PROGRAM,fidoctl,bin,$(KEILAND_FREEBSD_FIDOCTL_SOURCES),,-lcrypto))
