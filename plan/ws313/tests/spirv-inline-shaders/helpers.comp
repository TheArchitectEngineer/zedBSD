#version 450
// A compute shader with nested helpers, one called twice, and a void helper that stores.
layout(local_size_x = 4) in;
layout(set = 0, binding = 0) buffer B {
	uint data[];
} b;

uint hash(uint x)
{
	x ^= x >> 3;
	x *= 0x9E3779B1u;
	return x;
}

uint twice(uint x)
{
	return hash(hash(x));
}

void store(uint i, uint v)
{
	b.data[i] = v;
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	store(i, twice(b.data[i]) + hash(i));
}
