#version 310 es
// ws101-p008: buffer atomics of int and uint, with and without the old value, in a block without an instance name and one with.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer V { uint v[]; };
layout(std430, binding = 1) buffer H {
	uint bins[16];
	uint total;
	int smin;
	int smax;
	uint umin;
	uint umax;
	uint band;
	uint bor;
	uint bxor;
	uint swap;
	uint cas;
	uint count;
} h;
layout(std430, binding = 2) buffer R { uint old[]; };
uniform uint n;
void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i < n) {
		uint x = v[i];
		atomicAdd(h.bins[x % 16u], 1u);
		atomicAdd(h.total, x);
		atomicMin(h.smin, int(x) - 1000);
		atomicMax(h.smax, int(x) - 1000);
		atomicMin(h.umin, x);
		atomicMax(h.umax, x);
		atomicAnd(h.band, x | 0xffff0000u);
		atomicOr(h.bor, x);
		atomicXor(h.bxor, x);
		atomicExchange(h.swap, 7u);
		atomicCompSwap(h.cas, 0u, 1u);
		old[i] = atomicAdd(h.count, 1u);
	}
}
