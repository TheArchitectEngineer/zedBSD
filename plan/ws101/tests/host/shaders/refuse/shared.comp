#version 450
// ws101-p002: shared memory is lowered in p006; until then it is refused.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer O { uint o[]; };
shared uint tile[64];
void main()
{
	tile[gl_LocalInvocationIndex] = gl_LocalInvocationIndex;
	o[gl_GlobalInvocationID.x] = tile[63u - gl_LocalInvocationIndex];
}
