#version 450
// ws101-p002: two dynamic indices into a storage buffer (an array of arrays).
layout(local_size_x = 8, local_size_y = 4) in;
layout(std430, set = 0, binding = 0) buffer M { uint m[4][8]; };
layout(std430, set = 0, binding = 1) buffer T { uint t[8][4]; };
void main()
{
	uint x = gl_LocalInvocationID.x;
	uint y = gl_LocalInvocationID.y;
	t[x][y] = m[y][x] * 3u + 1u;
}
