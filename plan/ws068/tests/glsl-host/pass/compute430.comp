#version 430
// GLSL 4.30 (desktop GL 4.3): a compute shader with a shader storage block, shared memory and barrier().
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Values {
	uint count;
	float values[];
};
shared float partial[64];
void main()
{
	partial[gl_LocalInvocationID.x] = values[gl_GlobalInvocationID.x] * 2.0;
	barrier();
	values[gl_GlobalInvocationID.x] = partial[63u - gl_LocalInvocationID.x];
	atomicAdd(count, 1u);
}
