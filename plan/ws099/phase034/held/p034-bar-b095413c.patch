diff --git a/userland/desktop/wayland/glass.c b/userland/desktop/wayland/glass.c
index e6533556..072423d7 100644
--- a/userland/desktop/wayland/glass.c
+++ b/userland/desktop/wayland/glass.c
@@ -71,11 +71,12 @@
 #define GLASS_ICON_SIZES	2U
 
 /*
- * App Home's pictures, in pixels a side (on its 72-pixel tiles), and again
- * small for a window's mark by its title (a 20-pixel square, ws035-p124).
+ * App Home's pictures, in pixels a side (on its 72-pixel circles, ws128-p012),
+ * and again small for the marks of the system bar, Wiseview and a window's
+ * title (circles of 20 to 32 pixels, the picture about two thirds of it).
  */
-#define GLASS_APP_ICON_PIXELS	40U
-#define GLASS_APP_ICON_SMALL	14U
+#define GLASS_APP_ICON_PIXELS	48U
+#define GLASS_APP_ICON_SMALL	18U
 
 /* A cached glyph's cell in the atlas, in pixels a side, and the most cells there are. */
 #define GLASS_CELL		48U
@@ -1592,7 +1593,7 @@ glass_shape_draw(
 	 * shader's dark glass (mode -1); shadows, images and the blur's steps
 	 * are left as they are, and so is a shape drawn light.
 	 */
-	if (server->dark != 0 && shape->light == 0U) {
+	if (server->dark != 0 && shape->light == 0U && server->keep_colours == 0U) {
 		/* The colour of a shape that has one. */
 		if (shape->mode == MODE_GLASS || shape->mode == MODE_SOLID || shape->mode == MODE_RING || shape->mode == MODE_TEXT)
 			glass_dark_color(shape->color, &constants[12]);
@@ -1602,6 +1603,10 @@ glass_shape_draw(
 			constants[17] = -1.0f;
 	}
 
+	/* Glass asked to be dark is the dark glass in either appearance, its colour as given (the system bar). */
+	if (shape->dark_glass != 0U && shape->mode == MODE_GLASS)
+		constants[17] = -1.0f;
+
 	/*
 	 * A shape without an image of its own is given the blurred scene under
 	 * the window being drawn when there is one (backdrop.c), else the
@@ -2105,8 +2110,12 @@ atlas_icons(
 		pen_x += GLASS_APP_ICON_PIXELS + 1U;
 	}
 
-	/* The small pictures after them in the same row, when they fit. */
-	if (pen_x + GLASS_ICON_APPS * (GLASS_APP_ICON_SMALL + 1U) > GLASS_ATLAS_WIDTH)
+	/* The small pictures in a row of their own under them. */
+	*pen_y += GLASS_APP_ICON_PIXELS + 1U;
+	pen_x = 0;
+	if (*pen_y + GLASS_APP_ICON_SMALL > GLASS_ATLAS_HEIGHT)
+		return ENOSPC;
+	if (GLASS_ICON_APPS * (GLASS_APP_ICON_SMALL + 1U) > GLASS_ATLAS_WIDTH)
 		return ENOSPC;
 
 	/* Each small picture's coverage, into the atlas, and its place. */
@@ -2126,8 +2135,8 @@ atlas_icons(
 		pen_x += GLASS_APP_ICON_SMALL + 1U;
 	}
 
-	/* The row after the pictures. */
-	*pen_y += GLASS_APP_ICON_PIXELS + 1U;
+	/* The row after the small pictures. */
+	*pen_y += GLASS_APP_ICON_SMALL + 1U;
 
 	/* Succeeded: the icons are in the atlas. */
 	return 0;
diff --git a/userland/desktop/wayland/glass.h b/userland/desktop/wayland/glass.h
