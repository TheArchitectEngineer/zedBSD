+   /* The mutex serializes the final callback with later CPU0 fences, including sequence wrap. */
+   mtx_lock(&ctx->quiesce.mutex);
+   ctx->quiesce.failed = !stopped;
+   ctx->quiesce.done = stopped;
+   if (stopped && ctx->quiesce.fence_pending) {
+      ctx->retire_fence(ctx->ctx_id, 0, ctx->quiesce.fence_id);
+      ctx->quiesce.fence_pending = false;
+   }
+   mtx_unlock(&ctx->quiesce.mutex);
+   return 0;
+}
