+/* A backend-only payload lies outside the standard Venus opcode namespace. */
+static bool
+vkr_context_is_quiesce(const void *buffer, size_t size)
+{
+   static const uint8_t command[16] = {
+      0x51, 0x53, 0x42, 0x5a, 0x01, 0x00, 0x00, 0x00,
+      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+   };
+   return size == sizeof(command) && memcmp(buffer, command, sizeof(command)) == 0;
+}
+
+/* No decoder mutates device lists after admission closes; ring contexts are refused. */
+static int
+vkr_context_quiesce_thread(void *argument)
+{
+   struct vkr_context *ctx = argument;
+   struct vkr_instance *instance = ctx->instance;
+   bool stopped = true;
+
+   /* Actual device idle covers all queues, including raw inline work without a job marker. */
+   for (uint32_t index = 0; instance && index < instance->physical_device_count; index++) {
+      struct vkr_physical_device *physical = instance->physical_devices[index];
+      if (!physical)
+         continue;
+      list_for_each_entry(struct vkr_device, dev, &physical->devices, base.track_head) {
+         VkResult result = dev->proc_table.DeviceWaitIdle(dev->base.handle.device);
+         if (result != VK_SUCCESS) {
+            vkr_log("quiesce native idle failed (%d), context %u", result, ctx->ctx_id);
+            stopped = false;
+            break;
+         }
+      }
+      if (!stopped)
+         break;
+   }
+
+   /* A returned native fence may still be borrowed by a delayed host retirement callback. */
+   for (uint32_t index = 0; stopped && instance && index < instance->physical_device_count; index++) {
+      struct vkr_physical_device *physical = instance->physical_devices[index];
+      if (!physical)
+         continue;
+      list_for_each_entry(struct vkr_device, dev, &physical->devices, base.track_head) {
+         list_for_each_entry(struct vkr_queue, queue, &dev->queues, base.track_head) {
+            mtx_lock(&queue->sync_thread.mutex);
+            while (!list_is_empty(&queue->sync_thread.syncs)) {
+               struct timespec until;
+               timespec_get(&until, TIME_UTC);
+               until.tv_nsec += 100000000;
+               if (until.tv_nsec >= 1000000000) {
+                  until.tv_sec++;
+                  until.tv_nsec -= 1000000000;
+               }
+               cnd_timedwait(&queue->sync_thread.cond, &queue->sync_thread.mutex, &until);
+            }
+            mtx_unlock(&queue->sync_thread.mutex);
+         }
+      }
+   }
