+   /* Ring decoders can mutate native state concurrently and need a separate stop contract. */
+   mtx_lock(&ctx->ring_mutex);
+   has_rings = !list_is_empty(&ctx->rings);
+   mtx_unlock(&ctx->ring_mutex);
+   if (has_rings) {
