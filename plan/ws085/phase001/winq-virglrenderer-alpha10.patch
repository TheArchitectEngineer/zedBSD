+static bool
+vkr_context_quiesce_begin(struct vkr_context *ctx)
+{
+   bool has_rings;
+   int result;
+
+   mtx_lock(&ctx->quiesce.mutex);
+   if (ctx->quiesce.requested) {
+      mtx_unlock(&ctx->quiesce.mutex);
+      return true;
+   }
+   ctx->quiesce.requested = true;
