+	w->va = va;
+	w->top_dma = pp->top_pd_dma;
+	idx = va >> 12;
+	table = pp->top_pd;
+	for (lvl = pp->top, level = 0; lvl >= 0; lvl--, level++) {
+		unsigned i = (unsigned)((idx >> ((unsigned)lvl * 9u)) & 511u);
+		uint64_t raw;
