+int
+parity_gt_ppgtt_walk(struct parity_gt_ppgtt *pp, uint64_t va,
+	struct parity_gt_ppgtt_walk *w)
+{
+	struct parity_gt_object *table;
+	uint64_t idx;
+	int lvl, level;
