+	verify_async_put_domains_state(pd);
+	mutex_unlock(&pd->lock);
+}
+
+/* intel_display_power_put_async_work() */
+void
+parity_display_power_async_work(struct parity_power_domains *pd)
+{
+	mutex_lock(&pd->lock);
+	pd->async_work_runs++;
