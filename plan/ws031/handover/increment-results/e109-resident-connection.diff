+{
+	m->bits[d >> 6] |= (uint64_t)1u << (d & 63u);
+}
+
+static void
+mask_clear(struct parity_pw_domain_mask *m, unsigned d)
+{
+	m->bits[d >> 6] &= ~((uint64_t)1u << (d & 63u));
+}
+
+static int
+mask_empty(const struct parity_pw_domain_mask *m)
+{
+	return m->bits[0] == 0u && m->bits[1] == 0u;
