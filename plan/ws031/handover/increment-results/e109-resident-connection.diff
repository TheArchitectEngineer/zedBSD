+/* waits (yielding) until VDD reads off, at most `limit_ms`; returns the ms waited or -1 */
+static int wait_vdd_off(struct parity_edp_device *dev, unsigned limit_ms)
+{
+	unsigned waited = 0u;
+
+	while (vdd_is_on(dev)) {
+		if (waited >= limit_ms)
+			return -1;
+		parity_dp_kernel_sleep_us(&dev->k, 50000u);
+		waited += 50u;
+	}
+	return (int)waited;
