+		mask_set(&pd->async_put_domains[1], (unsigned)d);
+		if (delay_ms > pd->async_put_next_delay)
+			pd->async_put_next_delay = delay_ms;
+	} else {
+		mask_set(&pd->async_put_domains[0], (unsigned)d);
+		queue_async_put_domains_work(pd, delay_ms);
+	}
