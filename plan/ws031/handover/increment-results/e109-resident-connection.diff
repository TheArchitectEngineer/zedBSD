+	verify_async_put_domains_state(pd);
+	mutex_unlock(&pd->lock);
+}
+
+/* intel_display_power_flush_work() */
+void
+parity_display_power_flush_work(struct parity_power_domains *pd)
+{
+	struct parity_pw_domain_mask all;
