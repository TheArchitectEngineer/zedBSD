+static int intel_bios_ssc_frequency(struct drm_i915_private *i915,
+				    bool alternate)
+{
+	switch (DISPLAY_VER(i915)) {
+	case 2:
+		return alternate ? 66667 : 48000;
+	case 3:
+	case 4:
+		return alternate ? 100000 : 96000;
+	default:
+		return alternate ? 100000 : 120000;
+	}
+}
