+	 * reply-requested command is withdrawn by the caller's error path: the reply
+	 * length is only published on success.)
+	 */
 	(void)session;
-	(void)reader;
-	return 0;
+	(void)reply;
+	reader->error = 1;
+	return ENOTSUP;
 }
