diff --git a/src/drivers/gpu/i915/parity/vbt/parity_vbt.h b/src/drivers/gpu/i915/parity/vbt/parity_vbt.h
new file mode 100644
index 00000000..aa617490
--- /dev/null
+++ b/src/drivers/gpu/i915/parity/vbt/parity_vbt.h
@@ -0,0 +1,105 @@
+/*
+ * WS031 Linux-parity — the device-owned VBT state: what the rest of the parity
+ * driver sees of the VBT.  zedBSD project code.
+ *
+ * The parsing itself is the Linux 6.8.12 reference text (intel_bios_port.c,
+ * generated by plan/ws031/handover/tools/port_intel_bios.py).  This layer owns
+ * the memory, selects the byte source, and flattens the reference's private
+ * lists into plain records the display code can read without Linux types.
+ */
+#ifndef PARITY_VBT_H
+#define PARITY_VBT_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+/* Where the VBT bytes came from.  An explicit blob is NOT an OpRegion. */
+enum parity_vbt_origin {
+	PARITY_VBT_ORIGIN_NONE = 0,       /* no VBT: init_vbt_missing_defaults() */
+	PARITY_VBT_ORIGIN_OPREGION,       /* ASLS -> mailbox 4 / RVDA (native path) */
+	PARITY_VBT_ORIGIN_PCI_ROM,        /* $VBT in the PCI expansion ROM */
+	PARITY_VBT_ORIGIN_EXPLICIT_BLOB,  /* a named, hash-pinned blob supplied by the test configuration */
+};
+
+#define PARITY_VBT_MAX_ENCODERS 12
+struct parity_vbt_encoder {
+	int port;                 /* enum port value (0 = A, 3 = TC1 ...), -1 if none */
+	int aux_ch;               /* enum aux_ch value, -1 if none */
+	uint16_t device_type;
+	uint8_t dvo_port;
+	uint8_t ddc_pin_raw;      /* child.ddc_pin as in the VBT */
+	int ddc_pin;              /* mapped GMBUS pin (0 = none/invalid) */
+	int supports_dp, supports_edp, supports_hdmi, supports_dvi;
+	int supports_typec_usb, supports_tbt;
+	int lane_reversal, hpd_invert;
+	int dp_max_lane_count;    /* 0 = not limited by the VBT */
+	int dp_max_link_rate;     /* kHz-per-lane /10 as in the reference (e.g. 270000), 0 = platform max */
+	int dp_boost_level, hdmi_boost_level;
+	int hdmi_level_shift;     /* -1 = not set */
+};
+
+struct parity_vbt_panel {
+	int initialized;
+	int panel_type;
+	int bpp;                          /* eDP colour depth from the VBT: 18 / 24 / 30 */
+	int edp_rate;                     /* DP_LINK_BW_* code the VBT names for fast link */
+	int edp_lanes;
+	int edp_preemphasis, edp_vswing;
+	int edp_low_vswing;
+	int edp_max_link_rate;            /* 0 = not limited */
+	/* eDP panel power sequencing, in 100 us units as stored in the VBT */
+	uint16_t t1_t3, t8, t9, t10, t11_t12;
+	/* backlight */
+	int bl_present;
+	int bl_type;                      /* enum intel_backlight_type */
+	int bl_controller;
+	int bl_active_low_pwm;
+	uint16_t bl_pwm_freq_hz;
+	uint8_t bl_min_brightness;
+	/* the VBT's own panel mode, if it carries one (the EDID mode normally wins) */
+	int has_lfp_mode;
+	int mode_clock_khz;
+	uint16_t hdisplay, hsync_start, hsync_end, htotal;
+	uint16_t vdisplay, vsync_start, vsync_end, vtotal;
+	int drrs_type, vrr;
+};
+
+struct parity_vbt {
+	int inited;
+	int origin;                       /* enum parity_vbt_origin */
+	const uint8_t *bytes;             /* the validated VBT (not owned) */
+	size_t size;
+	uint16_t bdb_version;
+	char signature[21];
+	int missing_defaults_used;
+	unsigned num_bdb_blocks;
+	unsigned n_encoders;
+	struct parity_vbt_encoder enc[PARITY_VBT_MAX_ENCODERS];
+	/* general features the display code consumes */
+	int int_lvds_support, display_clock_mode, lvds_use_ssc, lvds_ssc_freq, crt_ddc_pin;
+	unsigned arena_used, arena_peak, alloc_failures;
+	unsigned log_errors;              /* drm_err / WARN lines the reference emitted */
+};
+
+/*
+ * intel_bios_init() on the given bytes (NULL/0 = no VBT -> missing defaults).
+ * The bytes must already be validated by parity_vbt_validate().  Returns 0, or
+ * -EBUSY when a VBT state is already live (one device).
+ */
+int parity_vbt_init(struct parity_vbt *v, const void *bytes, size_t size, int origin);
+/* intel_bios_is_valid_vbt(): 1 when the header, BDB offset and BDB size fit in `size`. */
+int parity_vbt_validate(const void *bytes, size_t size);
+/*
+ * intel_bios_init_panel_late() for the encoder on `port`, with the panel's EDID
+ * (128 bytes, may be NULL -> the reference's fallback panel type).  Fills *out.
+ */
+int parity_vbt_init_panel(struct parity_vbt *v, int port, const uint8_t *edid128,
+	struct parity_vbt_panel *out);
+const struct parity_vbt_encoder *parity_vbt_encoder_for_port(const struct parity_vbt *v, int port);
+/* intel_bios_driver_remove(): releases every list and the arena. */
+void parity_vbt_fini(struct parity_vbt *v);
+
+/* verbosity of the reference's drm_dbg_kms lines: 0 errors only, 1 +info, 2 +debug */
+void parity_vbt_set_log_level(int level);
+
+#endif /* PARITY_VBT_H */
diff --git a/src/drivers/gpu/i915/parity/vbt/parity_vbt_glue.inc b/src/drivers/gpu/i915/parity/vbt/parity_vbt_glue.inc
new file mode 100644
index 00000000..c8474da1
--- /dev/null
+++ b/src/drivers/gpu/i915/parity/vbt/parity_vbt_glue.inc
@@ -0,0 +1,273 @@
+/*
+ * WS031 Linux-parity — zedBSD glue for the generated VBT parser.  zedBSD project
+ * code; it is included at the end of intel_bios_port.c because the reference
+ * keeps struct intel_bios_encoder_data and its helpers private to that file.
+ *
+ * Owns: the single drm_i915_private stand-in, the arena every reference
+ * allocation comes from, the byte source handed to intel_bios_init(), and the
+ * flattening of the reference lists into struct parity_vbt.
+ */
+#include "parity_vbt.h"
+
+#define PARITY_VBT_ARENA_BYTES (48u * 1024u)
+
+static struct drm_i915_private vbt_i915;
+static uint8_t vbt_arena[PARITY_VBT_ARENA_BYTES];
+static unsigned vbt_arena_used, vbt_arena_peak, vbt_alloc_failures;
+static const void *vbt_provider_bytes;
+static struct parity_vbt *vbt_live;
+static int vbt_log_level;
+static unsigned vbt_log_errors;
+
+void *
+parity_vbt_zalloc(size_t bytes)
+{
+	unsigned need = (unsigned)((bytes + 15u) & ~(size_t)15u);
+	void *p;
+
+	if (bytes == 0u || need > PARITY_VBT_ARENA_BYTES - vbt_arena_used) {
+		vbt_alloc_failures++;
+		return 0;
+	}
+	p = &vbt_arena[vbt_arena_used];
+	vbt_arena_used += need;
+	if (vbt_arena_used > vbt_arena_peak)
+		vbt_arena_peak = vbt_arena_used;
+	memset(p, 0, need);
+	return p;
+}
+
+void
+parity_vbt_free(void *p)
+{
+	/* A bump arena: individual frees are no-ops, parity_vbt_fini() releases everything. */
+	(void)p;
+}
+
+const void *
+parity_vbt_provider_get(struct drm_i915_private *i915)
+{
+	(void)i915;
+	return vbt_provider_bytes;
+}
+
+void
+parity_vbt_set_log_level(int level)
+{
+	vbt_log_level = level;
+}
+
+void
+parity_vbt_note(int level, const char *fmt)
+{
+	if (level == PARITY_VBT_LOG_ERR)
+		vbt_log_errors++;
+	if (level <= vbt_log_level)
+		parity_vbt_emit(fmt);
+}
+
+int
+parity_vbt_log_enabled(int level)
+{
+	if (level == PARITY_VBT_LOG_ERR)
+		vbt_log_errors++;
+	return level <= vbt_log_level;
+}
+
+void
+drm_mode_set_name(struct drm_display_mode *mode)
+{
+	/* "<hdisplay>x<vdisplay>" without a formatted-print dependency */
+	unsigned v[2] = { mode->hdisplay, mode->vdisplay };
+	unsigned i, n = 0u;
+
+	for (i = 0u; i < 2u; i++) {
+		char tmp[8];
+		unsigned k = 0u, x = v[i];
+
+		do { tmp[k++] = (char)('0' + x % 10u); x /= 10u; } while (x != 0u && k < sizeof(tmp));
+		while (k > 0u && n + 1u < sizeof(mode->name))
+			mode->name[n++] = tmp[--k];
+		if (i == 0u && n + 1u < sizeof(mode->name))
+			mode->name[n++] = 'x';
+	}
+	mode->name[n] = '\0';
+}
+
+int
+parity_vbt_validate(const void *bytes, size_t size)
+{
+	return intel_bios_is_valid_vbt(bytes, size) ? 1 : 0;
+}
+
+int
+parity_vbt_init(struct parity_vbt *v, const void *bytes, size_t size, int origin)
+{
+	struct intel_bios_encoder_data *devdata;
+	struct bdb_block_entry *entry;
+	unsigned i;
+
+	if (v == 0)
+		return -22;
+	if (vbt_live != 0)
+		return -16;
+	memset(v, 0, sizeof(*v));
+	memset(&vbt_i915, 0, sizeof(vbt_i915));
+	vbt_arena_used = 0u;
+	vbt_arena_peak = 0u;
+	vbt_alloc_failures = 0u;
+	vbt_log_errors = 0u;
+
+	if (bytes != 0 && size != 0u) {
+		const struct vbt_header *h = bytes;
+
+		v->bytes = bytes;
+		v->size = size;
+		v->origin = origin;
+		for (i = 0u; i < sizeof(h->signature) && i + 1u < sizeof(v->signature); i++)
+			v->signature[i] = (char)h->signature[i];
+	} else {
+		bytes = 0;
+		v->origin = PARITY_VBT_ORIGIN_NONE;
+	}
+	vbt_provider_bytes = bytes;
+	vbt_live = v;
+
+	intel_bios_init(&vbt_i915);
+
+	v->bdb_version = vbt_i915.display.vbt.version;
+	v->missing_defaults_used = bytes == 0;
+	v->int_lvds_support = (int)vbt_i915.display.vbt.int_lvds_support;
+	v->display_clock_mode = (int)vbt_i915.display.vbt.display_clock_mode;
+	v->lvds_use_ssc = (int)vbt_i915.display.vbt.lvds_use_ssc;
+	v->lvds_ssc_freq = vbt_i915.display.vbt.lvds_ssc_freq;
+	v->crt_ddc_pin = vbt_i915.display.vbt.crt_ddc_pin;
+	list_for_each_entry(entry, &vbt_i915.display.vbt.bdb_blocks, node)
+		v->num_bdb_blocks++;
+
+	list_for_each_entry(devdata, &vbt_i915.display.vbt.display_devices, node) {
+		struct parity_vbt_encoder *e;
+
+		if (v->n_encoders >= PARITY_VBT_MAX_ENCODERS)
+			break;
+		e = &v->enc[v->n_encoders++];
+		e->port = (int)intel_bios_encoder_port(devdata);
+		e->aux_ch = (int)intel_bios_dp_aux_ch(devdata);
+		e->device_type = devdata->child.device_type;
+		e->dvo_port = devdata->child.dvo_port;
+		e->ddc_pin_raw = devdata->child.ddc_pin;
+		e->ddc_pin = intel_bios_hdmi_ddc_pin(devdata);
+		e->supports_dp = intel_bios_encoder_supports_dp(devdata);
+		e->supports_edp = intel_bios_encoder_supports_edp(devdata);
+		e->supports_hdmi = intel_bios_encoder_supports_hdmi(devdata);
+		e->supports_dvi = intel_bios_encoder_supports_dvi(devdata);
+		e->supports_typec_usb = intel_bios_encoder_supports_typec_usb(devdata);
+		e->supports_tbt = intel_bios_encoder_supports_tbt(devdata);
+		e->lane_reversal = intel_bios_encoder_lane_reversal(devdata);
+		e->hpd_invert = intel_bios_encoder_hpd_invert(devdata);
+		e->dp_max_lane_count = intel_bios_dp_max_lane_count(devdata);
+		e->dp_max_link_rate = intel_bios_dp_max_link_rate(devdata);
+		e->dp_boost_level = intel_bios_dp_boost_level(devdata);
+		e->hdmi_boost_level = intel_bios_hdmi_boost_level(devdata);
+		e->hdmi_level_shift = intel_bios_hdmi_level_shift(devdata);
+	}
+
+	v->arena_used = vbt_arena_used;
+	v->arena_peak = vbt_arena_peak;
+	v->alloc_failures = vbt_alloc_failures;
+	v->log_errors = vbt_log_errors;
+	v->inited = 1;
+	return 0;
+}
