# ws159-p006 proposal (not applied): a HAL call to set how an ISA-numbered IRQ is
# signalled, so that the Intel GPIO controller's IRQ 14 (ACPI _CRS of \_SB.GPI0:
# Interrupt (Level, ActiveLow, Shared)) can be programmed as level / active low.
# The Latitude 5330's MADT has no Interrupt Source Override for IRQ 14, so the
# amd64 HAL programs pin 14 as an ISA line (edge, active high), on which the
# controller's level-low output never gives a usable interrupt.
#
# The touchpad's GPIO interrupt reaches the CPU only through that controller IRQ:
# its pad is in GPIO-driver mode (HOSTSW_OWN=1, no IOxAPIC route; Linux uses
# "intel-gpio 327" under "IR-IO-APIC 14-fasteoi INTC1055:00").
--- a/include/hal/hal.h
+++ b/include/hal/hal.h
@@ (after hal_irq_unmask)
+/*
+ * How a numbered IRQ is signalled, for hal_irq_set_trigger(): level rather
+ * than edge triggered, and active low rather than active high.
+ */
+#define HAL_IRQ_TRIGGER_LEVEL		0x1U
+#define HAL_IRQ_TRIGGER_ACTIVE_LOW	0x2U
+
+/*
+ * Set how a numbered IRQ is signalled (HAL_IRQ_TRIGGER_*), as the device's
+ * firmware description says (an ACPI _CRS Interrupt descriptor), in place
+ * of the default for its line (the ISA default, or the MADT's override).
+ * A routed IRQ is rewritten at once.  Returns HAL_ERR_UNSUPPORTED where
+ * the interrupt controller cannot change it.
+ */
+int
+hal_irq_set_trigger(
+	int irq_num,
+	unsigned flags);
--- a/src/hal/amd64/bsp-pcat/ioapic.c
+++ b/src/hal/amd64/bsp-pcat/ioapic.c
+ amd64_ioapic_set_trigger(irq, flags): irq_flags[irq] = MPS INTI flags
+   (polarity bits 1:0 = 01 high / 11 low, trigger bits 3:2 = 01 edge / 11 level),
+   and when the line is routed, write_route() again with its destination and mask.
--- a/src/hal/amd64/irq.c
+++ b/src/hal/amd64/irq.c
+ hal_irq_set_trigger(): validates 0 <= irq < 16, calls amd64_ioapic_set_trigger().
--- other architectures: hal_irq_set_trigger() returns HAL_ERR_UNSUPPORTED.
--- a/include/kern/irq.h, src/kern/irq.c
+ kern_irq_set_trigger(irq, level, active_low): the kernel's wrapper (not HAL).
