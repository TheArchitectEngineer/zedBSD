+/*
+ * Gives back, once, the INIT reference the probe kept for a takeover
+ * (intel_power_domains_enable()): every well nothing references then
+ * powers down.  when names the point in the run for the log.
+ */
+static void
+i915_resident_power_enable(
+	struct i915_display *display,
+	const char *when)
+{
+	/* Nothing was kept, or it went back already. */
+	if (!display->dprobe.power_domains_enable_deferred)
+		return;
+
+	/* The reference goes back, and the wells it kept on are counted before and after. */
+	display->dprobe.power_domains_enable_deferred = 0;
+	drv_i915_power_domains_enable(&display->dprobe, &display->dcore);
+	kern_logf("i915: takeover: power_domains_enable (%s): wells_on %u -> %u\n", when, display->dprobe.wells_on_before, display->dprobe.wells_on_after);
+}
