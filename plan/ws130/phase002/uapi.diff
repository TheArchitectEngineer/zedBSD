+struct in6_pktinfo {
+	struct in6_addr ipi6_addr;
+	unsigned ipi6_ifindex;
+};
+
+/* A lifetime (seconds) that does not run out: an address's, or a route's. */
+#define IN6_LIFETIME_INFINITE	0xffffffffU
