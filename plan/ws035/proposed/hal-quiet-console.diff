+/* Reports whether the boot parameters have the whole token kmsg=quiet. */
+static int
+quiet_boot(
+	void)
+{
+	static const char token[] = "kmsg=quiet";
+	const char *text;
+	unsigned position;
+	unsigned index;
+	int same;
+
+	/* The parameters the loader handed over. */
+	text = hal_get_arch_handoff("boot.command-line");
+	if (text == NULL)
+		return 0;
+
+	/* Each space-separated token, compared whole. */
+	position = 0;
+	while (position < KERN_BOOT_PARAMETERS_STORAGE_SIZE && text[position] != '\0') {
+		/* A separator. */
+		if (text[position] == ' ' || text[position] == '\t' || text[position] == '\n' || text[position] == '\r') {
+			position++;
+			continue;
+		}
+
+		/* The token against kmsg=quiet. */
+		same = 1;
+		for (index = 0; index + 1U < sizeof(token); index++) {
+			if (position + index >= KERN_BOOT_PARAMETERS_STORAGE_SIZE || text[position + index] != token[index]) {
+				same = 0;
+				break;
+			}
+		}
+		if (same) {
+			position += index;
+			if (position >= KERN_BOOT_PARAMETERS_STORAGE_SIZE || text[position] == '\0' || text[position] == ' ' || text[position] == '\t' || text[position] == '\n' || text[position] == '\r')
+				return 1;
+		}
+
+		/* The rest of the token. */
+		while (position < KERN_BOOT_PARAMETERS_STORAGE_SIZE && text[position] != '\0' && text[position] != ' ' && text[position] != '\t' && text[position] != '\n' && text[position] != '\r')
+			position++;
+	}
+
+	/* Not a quiet boot. */
+	return 0;
+}
+
+/*
+ * Paints the progress panel at the top right (136x40, where the loader's
+ * stages and the kernel's entry draw their blocks) with the colour just left
+ * of it, which is the logo's background on a quiet boot.
+ */
+static void
+quiet_panel_locked(
+	void)
+{
+	uint32_t background;
+	unsigned x;
+	unsigned y;
+	unsigned left;
+
+	/* Too narrow a screen has no panel. */
+	if (framebuffer->width <= 137U || framebuffer->height < 40U)
+		return;
+
+	/* The colour beside the panel, over the whole panel. */
+	left = framebuffer->width - 136U;
+	background = framebuffer_pixels[left - 1U];
+	for (y = 0; y < 40U; y++) {
+		for (x = left; x < framebuffer->width; x++)
+			framebuffer_pixels[(uint64_t)y * framebuffer->stride + x] = background;
+	}
+}
