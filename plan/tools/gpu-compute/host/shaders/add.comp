#version 450
// ws101-p002: c[i] = a[i] + b[i] for i < n, the rest untouched (an early return).
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer A { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer B { uint b[]; };
layout(std430, set = 0, binding = 2) buffer C { uint c[]; };
layout(push_constant) uniform P { uint n; } p;
void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= p.n)
		return;
	c[i] = a[i] + b[i];
}
