#version 310 es
// ws101-p008: c[i] = a[i] + b[i] + k for i < n (an early return), instance names, the default uniform block.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer A { uint a[]; };
layout(std430, binding = 1) readonly buffer B { uint b[]; } bb;
layout(std430, binding = 2) writeonly buffer C { uint c[]; };
uniform uint n;
uniform uint k;
void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= n)
		return;
	c[i] = a[i] + bb.b[i] + k;
}
