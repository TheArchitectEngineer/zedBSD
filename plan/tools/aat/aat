# The US layout's characters: the key, and whether Shift is held.
US_SHIFTED = {
	"!": "1", "@": "2", "#": "3", "$": "4", "%": "5", "^": "6", "&": "7", "*": "8", "(": "9",
	")": "0", "_": "minus", "+": "equal", "{": "leftbrace", "}": "rightbrace", ":": "semicolon",
	"\"": "apostrophe", "~": "grave", "|": "backslash", "<": "comma", ">": "dot", "?": "slash",
