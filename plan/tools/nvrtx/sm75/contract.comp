#version 450
// A product read once by an addition: the compiler may fuse them into one FFMA.
layout(local_size_x = 16) in;
layout(std430, set = 0, binding = 0) readonly buffer I { float x[]; };
layout(std430, set = 0, binding = 1) buffer O { float o[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	o[i] = x[i] * x[i + 1u] + x[i + 2u];
}
