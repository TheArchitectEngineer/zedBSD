#version 450
// ws037-p008 stage B: unsigned and signed division and remainder.
layout(local_size_x = 32) in;
layout(std430, set = 0, binding = 0) readonly buffer I { uint v[]; };
layout(std430, set = 0, binding = 1) buffer O { uint o[]; };
void main()
{
	uint g = gl_GlobalInvocationID.x;
	uint a = v[g * 2u];
	uint b = v[g * 2u + 1u];
	o[g * 4u] = a / b;
	o[g * 4u + 1u] = a % b;
	o[g * 4u + 2u] = uint(int(a) / int(b));
	o[g * 4u + 3u] = uint(int(a) % int(b));
}
