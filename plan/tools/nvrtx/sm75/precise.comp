#version 450
// The same arithmetic as contract.comp with a precise result (NoContraction): the product and the sum stay apart.
layout(local_size_x = 16) in;
layout(std430, set = 0, binding = 0) readonly buffer I { float x[]; };
layout(std430, set = 0, binding = 1) buffer O { float o[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	precise float r = x[i] * x[i + 1u] + x[i + 2u];
	o[i] = r;
}
