+/*
+ * ws075-p028 experiment: uses the blurred scene kept for this place of the
+ * window list when what it showed is unchanged (the signature); the glass
+ * drawn from now on samples it.  Returns 1 when it was used.
+ */
+int
+zwl_backdrop_reuse(
+	struct zwl_server *server,
+	unsigned place,
+	uint64_t signature)
+{
+	struct zwl_backdrop *backdrop;
+
+	/* Only a kept scene of the same signature. */
+	backdrop = &server->compose->backdrop;
+	if (backdrop->state != BACKDROP_READY || place >= ZWL_BACKDROP_CACHE)
+		return 0;
+	if (!backdrop->cache_valid[place] || backdrop->cache_signature[place] != signature)
+		return 0;
+
+	/* The glass from now on is on it. */
+	server->compose->backdrop_set = backdrop->cache[place].set;
+	backdrop->reused++;
+	return 1;
+}
+
+/*
+ * ws075-p028 experiment: zwl_backdrop_end, whose last pass writes the
+ * blurred scene into the kept image of this place of the window list.
+ */
+void
+zwl_backdrop_end_cached(
+	struct zwl_server *server,
+	VkCommandBuffer command,
+	unsigned place,
+	uint64_t signature)
+{
+	struct zwl_compose *compose;
+	struct zwl_backdrop *backdrop;
+	struct zwl_backdrop_target *last;
+	VkRenderPassBeginInfo pass;
+	unsigned round;
+	VkResult result;
+
+	/* The kept image of the place, made the first time. */
+	compose = server->compose;
+	backdrop = &compose->backdrop;
+	last = &backdrop->targets[0];
+	if (place < ZWL_BACKDROP_CACHE) {
+		if (!backdrop->cache_made[place]) {
+			result = backdrop_target(compose, &backdrop->cache[place]);
+			if (result == VK_SUCCESS)
+				backdrop->cache_made[place] = 1U;
+		}
+		if (backdrop->cache_made[place])
+			last = &backdrop->cache[place];
+	}
+
+	/* The scene's pass ends; blurred across and down, the last pass into the kept image. */
+	vkCmdEndRenderPass(command);
+	for (round = 0; round < BACKDROP_ROUNDS; round++) {
+		backdrop_blur(server, command, &backdrop->targets[0], &backdrop->targets[1], BACKDROP_SPREAD / (float)backdrop->width, 0.0f);
+		if (round + 1U == BACKDROP_ROUNDS) {
+			backdrop_blur(server, command, &backdrop->targets[1], last, 0.0f, BACKDROP_SPREAD / (float)backdrop->height);
+		} else {
+			backdrop_blur(server, command, &backdrop->targets[1], &backdrop->targets[0], 0.0f, BACKDROP_SPREAD / (float)backdrop->height);
+		}
+	}
+
+	/* The output's pass again, keeping what was drawn. */
+	memset(&pass, 0, sizeof(pass));
+	pass.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+	pass.renderPass = compose->pass_load;
+	pass.framebuffer = compose->framebuffer_now;
+	pass.renderArea.extent.width = compose->output.width;
+	pass.renderArea.extent.height = compose->output.height;
+	vkCmdBeginRenderPass(command, &pass, VK_SUBPASS_CONTENTS_INLINE);
+	backdrop_viewport(command, compose->output.width, compose->output.height);
+	vkCmdSetScissor(command, 0U, 1U, &compose->scissor_now);
+
+	/* The glass from now on is on the blurred scene, kept for the next frames. */
+	compose->backdrop_set = last->set;
+	if (last != &backdrop->targets[0]) {
+		backdrop->cache_valid[place] = 1U;
+		backdrop->cache_signature[place] = signature;
+	}
+	backdrop->drawn++;
+}
