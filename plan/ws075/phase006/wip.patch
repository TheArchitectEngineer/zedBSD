+/* Keeps a dynamic stencil mask or reference for the faces it names (bit 0 front, bit 1 back). */
+static void
+i915_execute_set_stencil(
+	struct i915_gfx_draw_state *state,
+	const struct i915_gfx_op *op)
+{
+	uint32_t *values;
+	uint32_t face;
+
+	/* The array the value goes into. */
