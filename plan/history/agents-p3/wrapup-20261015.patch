+/* Reports nonzero when a program header is the expected one in all its words, printing the first word that differs. */
+static int
+header_is(
+	const uint32_t *sph,
+	const uint32_t *want)
+{
+	unsigned index;
+
+	/* Each word against the expected one. */
+	for (index = 0U; index < NVRTX_SM75_SPH_WORDS; index++) {
+		if (sph[index] != want[index]) {
+			printf("  header word %u is %08x, want %08x\n", index, (unsigned)sph[index], (unsigned)want[index]);
+			return 0;
+		}
+	}
+
+	/* Succeeded: every word is as expected. */
+	return 1;
+}
