#version 450
// A divergent loop with continue and break: data[x] = sum of the odd i < x, stopping past 50.
layout(local_size_x = 32) in;
layout(std430, set = 0, binding = 0) buffer Data { uint data[]; };
void main()
{
	uint x = gl_GlobalInvocationID.x;
	uint s = 0u;
	for (uint i = 0u; i < x; i++) {
		if ((i & 1u) == 0u)
			continue;
		s += i;
		if (s > 50u)
			break;
	}
	data[x] = s;
}
