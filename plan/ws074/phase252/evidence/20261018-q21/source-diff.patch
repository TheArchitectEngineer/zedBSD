+		layout_context_begin(tree, &context, &floats);
+		error = layout_block(tree, child, container->width);
+		layout_context_end(tree, &context);
+		tree->measuring--;
+
+		/* Reads the measured height only after the complete layout succeeded. */
+		if (error == 0)
+			*basis = child->height;
+	}
