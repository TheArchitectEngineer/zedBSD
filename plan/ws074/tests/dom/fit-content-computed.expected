px fit-content(10px) / fit-content(10px)
percent fit-content(25%) / fit-content(25%)
em fit-content(40px) / fit-content(40px)
calc-em fit-content(30px) / fit-content(30px)
calc-negative-px fit-content(0px) / fit-content(0px)
calc-negative-percent fit-content(0%) / fit-content(0%)
calc-mixed fit-content(calc(10% + 5px)) / fit-content(calc(10% + 5px))
zero-px fit-content(0px) / fit-content(0px)
zero-percent fit-content(calc(0% + 10px)) / fit-content(calc(0% + 10px))
cancelled-percent fit-content(calc(0% + 10px)) / fit-content(calc(0% + 10px))
live-before fit-content(30px) / fit-content(30px)
live-after fit-content(20px)
grid-auto fit-content(50px) / fit-content(50px)
grid-computed-auto fit-content(50px)
child fit-content(20px)
invalid-initial fit-content(2px) / fit-content(2px)
invalid-fr fit-content(2px)
