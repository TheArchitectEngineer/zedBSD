| <!DOCTYPE html>
| <html>
|   lang="en"
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "browser: block and inline layout"
|     "
"
|     <style>
|       "
body { font-family: sans-serif; margin: 10px; }
.box { background: #e8eef7; border: 2px solid #336; padding: 6px; margin: 20px 0 30px; }
.centered { width: 300px; margin: 10px auto; border: 1px solid #999; }
.narrow { max-width: 200px; min-height: 50px; border: 1px solid #c33; }
.wide { width: 50%; min-width: 350px; border: 1px solid #3c3; }
.empty { margin: 15px 0 25px; }
.outer { margin-top: 12px; }
.outer .inner { margin-top: 18px; }
.right { text-align: right; }
.center { text-align: center; }
.contents { display: contents; }
.gone { display: none; }
.lh { line-height: 1.5; }
.lhpx { line-height: 30px; }
pre { background: #eee; }
.nowrap { white-space: nowrap; width: 120px; border: 1px solid #aaa; }
.preline { white-space: pre-line; }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       class="box"
|       "A box with a border, padding and margins that collapse with its neighbours."
|     "
"
|     <div>
|       class="box"
|       "A second box: the 30px bottom margin above and this 20px top margin make 30px."
|     "
"
|     <div>
|       class="empty"
|     "
"
|     <div>
|       class="centered"
|       "A centered block of 300px."
|     "
"
|     <div>
|       class="narrow"
|       "At most 200px wide, at least 50px tall, with text that wraps over lines."
|     "
"
|     <div>
|       class="wide"
|       "Half the width but not under 350px."
|     "
"
|     <div>
|       class="outer"
|       <div>
|         class="inner"
|         "The inner top margin collapses through the outer one."
|     "
"
|     <p>
|       class="right"
|       "Aligned to the right."
|     "
"
|     <p>
|       class="center"
|       "Centered text"
|       <br>
|       "over two lines."
|     "
"
|     <div>
|       class="contents"
|       <p>
|         "A paragraph whose parent has display: contents."
|     "
"
|     <div>
|       class="gone"
|       "Not shown."
|     "
"
|     <p>
|       class="lh"
|       "Line height 1.5 on text long enough to wrap onto a second line when the window is narrow enough for that to happen at all."
|     "
"
|     <p>
|       class="lhpx"
|       "Line height of thirty pixels."
|     "
"
|     <pre>
|       "Preformatted   text
    keeps its spaces
and its line breaks."
|     "
"
|     <div>
|       class="nowrap"
|       "No wrapping here even though the box is narrow."
|     "
"
|     <p>
|       class="preline"
|       "pre-line keeps
line breaks   but collapses spaces."
|     "
"
|     <ol>
|       "
"
|       <li>
|         "First
"
|         <ul>
|           <li>
|             "Nested bullet"
|           <li>
|             "Another"
|         "
"
|       "
"
|       <li>
|         "Second"
|       "
"
|     "
Text directly in the body, "
|     <span>
|       "in a span"
|     ", after the list.
"
|     <div>
|       "A block after anonymous inline content."
|     "


"
