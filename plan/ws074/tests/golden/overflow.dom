| <!DOCTYPE html>
| <html>
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "browser: overflow"
|     "
"
|     <style>
|       "
body { margin: 16px; font-family: sans-serif; color: #202833; background: #fafafa; }
.frame { width: 260px; height: 70px; border: 3px solid #4a6fa5; padding: 6px; margin: 0 0 12px 0; background: #ffffff; }
.hidden { overflow: hidden; }
.tall { height: 120px; background: #cfe0f5; }
.wide { width: 400px; height: 30px; background: #f5c9a6; }
.poke { position: relative; top: 40px; left: 200px; width: 120px; height: 40px; background: #b388d6; }
.side { float: left; width: 140px; height: 110px; margin-right: 12px; background: #9fd5b4; }
.context { overflow: hidden; background: #f3e3a2; padding: 6px; }
.outer { position: relative; height: 60px; background: #e6e6e6; }
.escape { position: absolute; left: 220px; top: 30px; width: 160px; height: 60px; background: #e89c6a; }
p { margin: 0 0 8px 0; }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       class="frame hidden"
|       <div>
|         class="tall"
|         "A block taller than its clipping parent: the part below the frame's padding box is cut off."
|     "
"
|     <div>
|       class="frame"
|       "
"
|       <div>
|         class="wide"
|         "Wider than the frame, not clipped (overflow is visible)."
|       "
"
|     "
"
|     <div>
|       class="frame hidden"
|       <div>
|         class="wide"
|         "Wider than the frame, clipped at its right padding edge."
|       <div>
|         class="poke"
|         "relative"
|     "
"
|     <div>
|       class="side"
|     "
"
|     <div>
|       class="context"
|       "This block has overflow: hidden, so it starts its own formatting context and keeps beside the float
instead of running under it. Its lines wrap in the room the float leaves, and its background stops at the float."
|     "
"
|     <p>
|       "After them."
|     "
"
|     <div>
|       class="outer"
|       <div>
|         class="frame hidden"
|         style="height: 30px"
|         <div>
|           class="escape"
|           "absolute: escapes the clip"
|     "


"
