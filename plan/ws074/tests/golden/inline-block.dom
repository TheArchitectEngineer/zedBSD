| <!DOCTYPE html>
| <html>
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "inline-block and vertical-align"
|     "
"
|     <!--  ws074-p060: inline blocks as atomic pieces of their lines, their baselines, and vertical-align.  -->
|     "
"
|     <style>
|       "
body { font-family: sans-serif; font-size: 14px; margin: 8px; }
.row { background: #eee; margin-bottom: 6px; }
.ib { display: inline-block; background: #cde; border: 1px solid #579; padding: 2px 4px; }
.tall { height: 40px; }
.two { width: 70px; }
.clip { overflow: hidden; height: 30px; }
.wide { width: 30%; }
.card { display: inline-block; width: 23%; margin: 0 1% 8px 0; background: #fff; border: 1px solid #ccc; vertical-align: top; }
.card .pic { height: 50px; background: #f90; }
.card .name { padding: 4px; }
.center { text-align: center; }
.auto { margin: 0 auto; }
.box { display: inline-block; width: 30px; height: 30px; background: #9c6; }
.top { vertical-align: top; }
.middle { vertical-align: middle; }
.bottom { vertical-align: bottom; }
.text-top { vertical-align: text-top; }
.text-bottom { vertical-align: text-bottom; }
.raise { vertical-align: 6px; }
.lower { vertical-align: -25%; }
.big { font-size: 28px; }
.nested { display: inline-block; background: #fdc; padding: 3px; }
.icon::before { content: "*"; display: inline-block; width: 16px; background: #fc9; text-align: center; margin-right: 4px; }
.btn { display: inline-block; background: #fd8; border: 1px solid #a80; border-radius: 3px; padding: 3px 10px; }
"
|     "
"
|   "
"
|   <body>
|     "
"
