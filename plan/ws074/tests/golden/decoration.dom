| <!DOCTYPE html>
| <html>
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "radius, shadow, opacity, outline"
|     "
"
|     <!--  ws074-p062: rounded corners, box shadows, opacity and outlines.  -->
|     "
"
|     <style>
|       "
body { font-family: sans-serif; font-size: 14px; margin: 10px; background: #fff; }
.row { margin-bottom: 14px; }
.b { display: inline-block; width: 90px; height: 50px; margin-right: 16px; vertical-align: top; background: #4a8; color: #fff; padding: 4px; }
.r4 { border-radius: 4px; }
.r12 { border-radius: 12px; }
.pill { border-radius: 999px; }
.circle { border-radius: 50%; width: 50px; }
.mixed { border-radius: 2px 16px 30px 0; }
.ellipse { border-radius: 40px / 15px; }
.slash { border-top-left-radius: 20px 8px; -webkit-border-bottom-right-radius: 10px; }
.bordered { background: #fff; color: #333; border: 3px solid #36c; border-radius: 10px; }
.thick { background: #fed; color: #333; border: 8px solid #c63; border-radius: 20px; }
.sides { background: #fff; color: #333; border-style: solid; border-width: 2px 6px; border-color: #d33 #3a3; border-radius: 12px; }
.card { background: #fff; color: #333; box-shadow: 0 2px 5px 0 rgba(213, 217, 217, 0.5); border: 1px solid #d5d9d9; border-radius: 8px; }
.hard { background: #fff; color: #333; box-shadow: 4px 4px 0 #555; }
.blur { background: #fff; color: #333; box-shadow: 0 0 12px rgba(0, 0, 0, 0.6); border-radius: 6px; }
.spread { background: #fff; color: #333; box-shadow: 0 0 0 4px #9cf; border-radius: 4px; }
.two { background: #fff; color: #333; box-shadow: 3px 3px 0 #f90, -3px -3px 0 #09f; }
.o5 { opacity: 0.5; }
.o0 { opacity: 0; }
.o30 { opacity: 30%; }
.outline { background: #eee; color: #333; outline: 2px solid #e47911; }
.offset { background: #eee; color: #333; outline: 1px dashed #333; outline-offset: 4px; }
.fade { opacity: 0.4; }
.btn { display: inline-block; background: #ffd814; border: 1px solid #fcd200; border-radius: 100px; padding: 6px 14px; box-shadow: 0 2px 5px 0 rgba(213, 217, 217, 0.5); color: #0f1111; }
"
|     "
"
|   "
