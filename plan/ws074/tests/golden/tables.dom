"
|     <!--  ws074-p037: the least of tables: automatic column widths, colspan, border-spacing, captions, row groups, vertical-align in cells, anonymous boxes.  -->
|     "
"
|     <style>
|       "
body { font-family: sans-serif; font-size: 14px; margin: 8px; }
table { margin-bottom: 10px; }
td, th { border: 1px solid #579; padding: 3px; }
th { background: #cde; }
.full { width: 100%; background: #eee; }
.fixed { width: 400px; border: 2px solid #333; }
.spacing { border-spacing: 8px 4px; background: #efe; }
.nospace { border-collapse: collapse; }
.w80 { width: 80px; }
.tall { height: 60px; }
.mid { vertical-align: middle; }
.top { vertical-align: top; }
.bottom { vertical-align: bottom; }
.center { margin-left: auto; margin-right: auto; }
.css { display: table; background: #fed; }
.css > .row { display: table-row; }
.css > .row > span { display: table-cell; border: 1px solid #a73; padding: 2px 6px; }
.inline { display: inline-table; background: #def; }
.pct { margin-bottom: 10px; }
.css > .row > .spacer { width: 10%; padding: 0 15px; border: none; }
.quarter { width: 25%; }
.inline > .c { display: table-cell; padding: 1px 4px; border: 1px solid #579; }
"
