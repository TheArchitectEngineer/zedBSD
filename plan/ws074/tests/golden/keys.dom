| <!DOCTYPE html>
| <html>
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "browser: keys"
|     "
"
|     <style>
|       "
body { margin: 0; font-family: sans-serif; background: #f4f6fa; color: #1d2433; }
.page { margin: 24px 32px; }
h1 { font-size: 26px; margin: 0 0 12px 0; }
.card { background: #ffffff; border: 1px solid #c9d3e0; padding: 12px 16px; margin: 0 0 12px 0; }
.tall { height: 1600px; background: #e3e9f2; }
#log { font-family: monospace; font-size: 14px; }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       class="page"
|       "
"
|       <h1>
|         id="heading"
|         "Keys, the focus and the wheel"
|       "
"
|       <div>
|         class="card"
|         "
"
|         <p>
|           <a>
|             id="one"
|             href="first.html"
|             "The first link"
|           ", "
|           <a>
|             id="two"
|             href="second.html"
|             tabindex="2"
|             "the second link (tabindex 2)"
|           "
and "
|           <span>
|             id="three"
|             tabindex="1"
|             "a span with tabindex 1"
|           "."
|         "
"
|         <p>
|           <button>
|             id="four"
|             "A button"
|           " "
|           <span>
|             id="plain"
|             "plain text, not focusable"
|         "
"
|         <p>
|           id="log"
|           "No key yet."
|         "
"
|       "
"
|       <div>
|         class="tall"
|         "A tall block to scroll through."
|       "
"
|       <div>
|         class="card"
|         "
"
|         <p>
|           <a>
|             id="last"
|             href="blocks.html"
|             "The last link, below the tall block"
|         "
"
|       "
"
|     "
"
|     <script>
|       "
var log = document.getElementById("log");
function note(text) {
  console.log(text);
  log.textContent = text;
}
document.addEventListener("keydown", function (event) {
  note("keydown key=" + event.key + " code=" + event.code + " keyCode=" + event.keyCode + " shift=" + event.shiftKey +
      " ctrl=" + event.ctrlKey + " alt=" + event.altKey + " repeat=" + event.repeat);
  if (event.key === "ArrowDown" && event.shiftKey) {
    event.preventDefault();
  }
});
document.addEventListener("keyup", function (event) {
  console.log("keyup key=" + event.key + " code=" + event.code);
});
document.addEventListener("keypress", function (event) {
  console.log("keypress key=" + event.key);
});
document.addEventListener("focusin", function (event) {
  console.log("focusin " + event.target.id);
});
document.addEventListener("focusout", function (event) {
  console.log("focusout " + event.target.id);
});
document.addEventListener("wheel", function (event) {
  console.log("wheel deltaY=" + event.deltaY + " ctrl=" + event.ctrlKey);
  if (event.ctrlKey) {
    event.preventDefault();
  }
});
document.addEventListener("mousedown", function (event) {
  console.log("mousedown button=" + event.button + " target=" + event.target.id);
});
document.addEventListener("mouseup", function (event) {
  console.log("mouseup button=" + event.button);
});
document.addEventListener("click", function (event) {
  console.log("click target=" + event.target.id);
});
document.getElementById("four").addEventListener("click", function (event) {
  note("the button was clicked");
});
"
