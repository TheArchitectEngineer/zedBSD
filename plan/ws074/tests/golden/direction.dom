| <!DOCTYPE html>
| <html>
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "direction"
|     "
"
|     <!--  ws074-p073: the least of direction: a right-to-left flex row, text-align start and end, and a sized block in a right-to-left block.  -->
|     "
"
|     <style>
|       "
body { font-family: sans-serif; font-size: 14px; margin: 8px; }
.row { display: flex; background: #eee; margin-bottom: 8px; }
.row > div { background: #cde; border: 1px solid #579; padding: 4px; }
.rtl { direction: rtl; }
.ltr { direction: ltr; }
.wide { flex: 1; }
.col-a { width: 200px; }
.col-b { width: 120px; }
.end { justify-content: flex-end; }
.rev { flex-direction: row-reverse; }
.text { background: #efe; margin-bottom: 8px; padding: 4px; }
.start { text-align: start; }
.endtext { text-align: end; }
.sized { width: 300px; background: #fdc; margin-bottom: 8px; }
.gap { gap: 10px; }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       class="row rtl"
|       <div>
|         class="ltr col-a"
|         "results (first)"
|       <div>
|         class="ltr col-b"
|         "filters (second)"
|     "
"
|     <div>
|       class="row rtl"
|       <div>
|         class="ltr wide"
|         "grows"
|       <div>
|         class="ltr col-b"
|         "fixed"
|     "
"
|     <div>
|       class="row rtl end"
|       <div>
|         class="ltr"
|         "flex-end"
|       <div>
|         class="ltr"
|         "in rtl"
|     "
"
|     <div>
|       class="row rtl rev"
|       <div>
|         class="ltr"
|         "row-reverse"
|       <div>
|         class="ltr"
|         "in rtl"
|     "
"
|     <div>
|       class="row rtl gap"
|       <div>
|         class="ltr"
|         "one"
|       <div>
|         class="ltr"
|         "two"
|       <div>
|         class="ltr"
|         "three"
|     "
"
|     <div>
|       class="text rtl"
|       "start in a right-to-left block"
|     "
"
|     <div>
|       class="text rtl endtext"
|       "end in a right-to-left block"
|     "
"
|     <div>
|       class="text endtext"
|       "end in a left-to-right block"
|     "
"
|     <div>
|       class="text rtl"
|       <div>
|         class="sized ltr"
|         "a 300px block in a right-to-left block"
|     "
"
|     <div>
|       dir="rtl"
|       class="text"
|       "the dir attribute"
|     "
"
|     <div>
|       class="row rtl"
|       <div>
|         class="ltr"
|         <div>
|           class="row"
|           <div>
|             "nested"
|           <div>
|             "left to right"
|       <div>
|         class="ltr"
|         "outer second"
|     "


"
