| <!DOCTYPE html>
| <html>
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "grid"
|     "
"
|     <!--  ws074-p072: the least of grid: templates, fr, repeat(), minmax(), spans, lines, gaps and alignment.  -->
|     "
"
|     <style>
|       "
body { font-family: sans-serif; font-size: 14px; margin: 8px; }
.g { display: grid; background: #eee; margin-bottom: 10px; }
.g > div { background: #cde; border: 1px solid #579; padding: 4px; }
.four { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 8px; row-gap: 12px; }
.mixed { grid-template-columns: 120px 1fr 2fr; gap: 6px; }
.autos { grid-template-columns: auto 1fr; gap: 4px; }
.spans { grid-template-columns: repeat(12, 1fr); gap: 4px; }
.s4 { grid-column: auto / span 4; }
.s6 { grid-column: span 6; }
.full { grid-column: 1 / -1; background: #fdc !important; }
.lines { grid-template-columns: 100px 100px 100px; grid-template-rows: 40px auto; gap: 5px; }
.c2 { grid-column: 2; }
.r2 { grid-row: 2; }
.area { grid-area: 1 / 3 / 3 / 4; background: #cfc !important; }
.align { grid-template-columns: repeat(3, 1fr); align-items: center; gap: 5px; }
.tall { height: 60px; }
.end { align-self: end; }
.startself { align-self: start; }
.center { grid-template-columns: repeat(2, 150px); justify-content: center; gap: 10px; }
.noTemplate { gap: 3px; }
.pct { grid-template-columns: 25% 75%; }
"
|     "
"
|   "
"
