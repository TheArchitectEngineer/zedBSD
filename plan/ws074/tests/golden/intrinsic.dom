| <!DOCTYPE html>
| <html>
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "intrinsic widths"
|     "
"
|     <!--  ws074-p074: width: max-content, min-content and fit-content.  -->
|     "
"
|     <style>
|       "
body { font-family: sans-serif; font-size: 14px; margin: 8px; }
.box { background: #cde; border: 2px solid #579; padding: 4px; margin-bottom: 8px; }
.max { width: max-content; }
.min { width: min-content; }
.fit { width: fit-content; }
.wfit { width: -webkit-fit-content; }
.narrow { width: 200px; background: #eee; margin-bottom: 8px; }
.border { box-sizing: border-box; }
.window { width: 500px; overflow: hidden; background: #eee; margin-bottom: 8px; }
.list { width: max-content; padding: 0 16px; margin: 0; list-style: none; }
.list li { display: inline-block; width: 150px; height: 40px; margin-right: 8px; background: #fc9; }
.float { float: left; width: max-content; background: #cfc; margin-right: 8px; }
.clear { clear: both; }
.floats { width: max-content; padding: 0 8px; background: #fee; margin: 8px 0; list-style: none; }
.floats li { float: left; width: calc((clamp(300px, 50vw, 600px) - 20px) / 4); height: 30px; margin-right: 6px; background: #9cf; }
.pic { width: max-content; background: #efe; padding: 2px; }
.pic img { width: 100%; height: 20px; display: block; }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       class="box max"
|       "max-content: as wide as the text on one line"
|     "
"
|     <div>
|       class="box min"
|       "minimum content: as wide as the longest word"
|     "
"
|     <div>
|       class="box fit"
|       "fit-content in a wide block"
|     "
"
|     <div>
|       class="narrow"
|       <div>
|         class="box fit"
|         "fit-content in a narrow block wraps its words to the room it has"
|     "
"
|     <div>
|       class="box wfit"
|       "-webkit-fit-content"
|     "
"
|     <div>
|       class="box max border"
|       "max-content with border-box"
|     "
"
|     <div>
|       class="window"
|       <ul>
|         class="list"
|         <li>
|           "one"
|         <li>
|           "two"
|         <li>
|           "three"
|         <li>
|           "four"
|         <li>
|           "five"
|     "
"
|     <div>
|       class="float"
|       "a float of max-content"
|     <div>
|       class="float"
|       "another"
|     "
"
|     <div>
|       class="clear"
|     "
"
|     <ul>
|       class="floats"
|       <li>
|         "a"
|       <li>
|         "b"
|       <li>
|         "c"
|     "
"
|     <div>
|       class="clear"
|     "
"
|     <div>
|       class="pic"
|       "a picture of 100% below "
|       <img>
|         alt=""
|     "


"
