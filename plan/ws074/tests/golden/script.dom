| <!DOCTYPE html>
| <html>
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "browser: scripts ran"
|     "
"
|     <style>
|       "
body { margin: 0; font-family: sans-serif; background: #eef2f7; color: #1d2433; }
.page { margin: 24px 32px; }
h1 { font-size: 26px; margin: 0 0 12px 0; }
.card { background: #ffffff; border: 1px solid #c9d3e0; padding: 12px 16px; margin: 0 0 12px 0; }
.button { background: #2f6fdd; color: #ffffff; padding: 8px 14px; border: 2px solid #1b4fa8; width: 200px; }
.button.on { background: #1f9d55; border-color: #13733c; }
.clock { font-family: monospace; font-size: 20px; }
li { margin: 2px 0; }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       class="page"
|       "
"
|       <h1>
|         id="heading"
|         "Scripts in the page"
|       "
"
|       <div>
|         class="card"
|         "
"
|         <p>
|           id="status"
|           "The script ran: it wrote this line and made the list below."
|         "
"
|         <div>
|           class="button"
|           id="button"
|           "Click me"
|         "
"
|         <p>
|           id="clicks"
|           "No clicks yet."
|         "
"
|       "
"
|       <div>
|         class="card"
|         "
"
|         <p>
|           class="clock"
|           id="clock"
|           "Ticks: 5"
|         "
"
|       "
"
|       <div>
|         class="card"
|         "
"
|         <ul>
|           id="list"
|           <li>
|             "DOM from JavaScript"
|           <li>
|             "setInterval ticks the clock"
|           <li>
|             "a click listener counts clicks"
|         "
"
|       "
"
|     "
"
|     <script>
|       "
var status = document.getElementById("status");
status.textContent = "The script ran: it wrote this line and made the list below.";
var list = document.getElementById("list");
var words = ["DOM from JavaScript", "setInterval ticks the clock", "a click listener counts clicks"];
for (var i = 0; i < words.length; i++) {
  var item = document.createElement("li");
  item.textContent = words[i];
  list.appendChild(item);
}
var count = 0;
var button = document.getElementById("button");
button.addEventListener("click", function (event) {
  count++;
  button.className = count % 2 === 1 ? "button on" : "button";
  button.textContent = "Clicked " + count + (count === 1 ? " time" : " times");
  document.getElementById("clicks").textContent = "The last click was at x=" + event.clientX + ", y=" + event.clientY + ".";
  var item = document.createElement("li");
  item.textContent = "click " + count;
  list.appendChild(item);
  console.log("clicked", count);
});
var ticks = 0;
setInterval(function () {
  ticks++;
  document.getElementById("clock").textContent = "Ticks: " + ticks;
  if (ticks <= 5)
    console.log("tick", ticks);
}, 1000);
window.addEventListener("load", function () {
  document.title = "browser: scripts ran";
  console.log("loaded", document.readyState);
});
"
|     "


"
