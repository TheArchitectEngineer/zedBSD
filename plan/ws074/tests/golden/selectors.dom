| <!DOCTYPE html>
| <html>
|   lang="en"
|   <head>
|     "
"
|     <meta>
|       charset="utf-8"
|     "
"
|     <title>
|       "browser: selectors and pseudo-elements"
|     "
"
|     <style>
|       "
:root { --accent: #36c; }
body { font-family: sans-serif; margin: 8px; }
p { margin: 3px 0; }
.list p:not(.skip) { background: #eef; }
.list :is(.one, .two) { color: var(--accent); }
:where(.list) p { padding-left: 4px; }
.list p { padding-left: 10px; }
.rows p:nth-child(odd) { background: #efe; }
.rows p:nth-child(3n+1) { border-left: 4px solid #393; }
.rows p:nth-child(-n+2) { font-weight: bold; }
.rows p:nth-last-child(1) { background: #fed; }
.types span:first-of-type { color: #c00; }
.types span:last-of-type { color: #00c; }
.types em:only-of-type { background: #ffc; }
.types span:nth-of-type(2) { text-decoration: underline; }
.card:has(> img) { border: 2px solid #393; }
.card:has(.flag) { background: #fdd; }
.card:has(+ .next) { border-bottom: 3px solid #939; }
.card { padding: 4px; margin: 4px 0; }
.form input:disabled { background: #ccc; }
.form input:checked + label { color: #393; }
.form input:placeholder-shown { border: 2px solid #c93; }
.quote::before { content: "\201C"; color: #999; }
.quote::after { content: "\201D"; color: #999; }
.label::before { content: attr(data-label) ": "; font-weight: bold; }
.label::after { content: attr(data-label); display: block; color: #666; }
.legacy:before { content: "* "; color: #c00; }
.clear::after { content: ""; display: table; clear: both; }
.float { float: left; width: 60px; height: 30px; background: #9cf; }
.badge { position: relative; padding-left: 24px; }
.badge::before { content: ""; position: absolute; left: 4px; top: 2px; width: 14px; height: 14px; background: #393; }
@supports not (selector(:has(+ *))) { .has-support { background: #f00; } }
@supports selector(:has(+ *)) { .has-support { background: #cfc; } }
"
|     "
"
|   "
"
|   <body>
|     "
"
|     <div>
|       class="list"
|       "
"
|       <p>
|         class="one"
|         ":is() and :not() give the accent color and a background."
|       "
"
|       <p>
|         class="two skip"
|         "A skipped paragraph with the accent color only."
|       "
"
|       <p>
|         ":where() has no specificity: the later padding wins."
|       "
"
|     "
"
|     <div>
|       class="rows"
|       "
"
|       <p>
|         "Row 1"
|       <p>
|         "Row 2"
|       <p>
|         "Row 3"
|       <p>
|         "Row 4"
|       <p>
|         "Row 5"
|       "
"
|     "
"
|     <div>
|       class="types"
|       <span>
|         "first span"
|       " "
|       <em>
|         "only em"
|       " "
|       <span>
|         "second span"
|       " "
|       <span>
|         "last span"
|     "
"
|     <div>
|       class="card"
|       <img>
|         alt=""
|         width="20"
|         height="20"
|       " A card with an image child."
|     "
"
|     <div>
|       class="card"
|       <span>
|         class="flag"
|         "flag"
|       " A card with a flag inside."
|     "
"
|     <div>
|       class="card"
|       "A card before a .next sibling."
|     "
"
|     <div>
|       class="next"
|       "The next sibling."
|     "
"
|     <div>
|       class="form"
|       "
"
|       <input>
|         type="text"
|         disabled=""
|         value="disabled"
|       "
"
|       <input>
|         type="checkbox"
|         id="c"
|         checked=""
|       <label>
|         for="c"
|         "checked label"
|       "
"
|       <input>
|         type="text"
|         placeholder="placeholder shown"
|       "
"
|     "
"
|     <p>
|       class="quote"
|       "Quoted text."
|     "
"
|     <p>
|       class="label"
|       data-label="Name"
|       "generated from an attribute."
|     "
"
|     <p>
|       class="legacy"
|       "A legacy single-colon :before."
|     "
"
|     <div>
|       class="clear"
|       <div>
|         class="float"
|       "A float cleared by a ::after."
|     "
"
|     <p>
|       class="badge"
|       "An absolutely placed ::before square."
|     "
"
|     <p>
|       class="has-support"
|       "@supports selector(:has())."
|     "


"
