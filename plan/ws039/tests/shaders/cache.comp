#version 450
// ws039-p007: more uniform words than the SGPRs keep (the cache of chunks): read before a loop, again at the start
// of its body, which then reads enough others to replace them, and after the loop.
layout(local_size_x = 32) in;
layout(std140, set = 0, binding = 0) uniform U { vec4 v[40]; } u;
layout(std430, set = 0, binding = 1) readonly buffer In { uint n[]; };
layout(std430, set = 0, binding = 2) buffer Out { float o[]; };
void main()
{
	uint g = gl_GlobalInvocationID.x;
	float s = 0.0;
	s += u.v[0].x;
	s += u.v[1].x;
	s += u.v[2].x;
	s += u.v[3].x;
	s += u.v[4].x;
	s += u.v[5].x;
	s += u.v[6].x;
	s += u.v[7].x;
	s += u.v[8].x;
	s += u.v[9].x;
	s += u.v[10].x;
	s += u.v[11].x;
	s += u.v[12].x;
	s += u.v[13].x;
	s += u.v[14].x;
	s += u.v[15].x;
	s += u.v[16].x;
	s += u.v[17].x;
	s += u.v[18].x;
	s += u.v[19].x;
	s += u.v[20].x;
	s += u.v[21].x;
	s += u.v[22].x;
	s += u.v[23].x;
	s += u.v[24].x;
	s += u.v[25].x;
	s += u.v[26].x;
	s += u.v[27].x;
	s += u.v[28].x;
	s += u.v[29].x;
	s += u.v[30].x;
	s += u.v[31].x;
	s += u.v[32].x;
	s += u.v[33].x;
	s += u.v[34].x;
	s += u.v[35].x;
	s += u.v[36].x;
	s += u.v[37].x;
	s += u.v[38].x;
	s += u.v[39].x;
	for (uint i = 0u; i < n[g] % 4u; i++) {
		s += u.v[39].z * float(i + 5u);
		s += u.v[16].y * float(i + 1u);
		s += u.v[17].z * float(i + 2u);
		s += u.v[18].w * float(i + 0u);
		s += u.v[19].x * float(i + 1u);
		s += u.v[20].y * float(i + 2u);
		s += u.v[21].z * float(i + 0u);
		s += u.v[22].w * float(i + 1u);
		s += u.v[23].x * float(i + 2u);
		s += u.v[24].y * float(i + 0u);
		s += u.v[25].z * float(i + 1u);
		s += u.v[26].w * float(i + 2u);
		s += u.v[27].x * float(i + 0u);
		s += u.v[28].y * float(i + 1u);
		s += u.v[29].z * float(i + 2u);
		s += u.v[30].w * float(i + 0u);
		s += u.v[31].x * float(i + 1u);
		s += u.v[32].y * float(i + 2u);
		s += u.v[33].z * float(i + 0u);
		s += u.v[34].w * float(i + 1u);
		s += u.v[35].x * float(i + 2u);
		s += u.v[36].y * float(i + 0u);
		s += u.v[37].z * float(i + 1u);
		s += u.v[38].w * float(i + 2u);
	}
	o[g] = s + u.v[39].w - u.v[0].x;
}
