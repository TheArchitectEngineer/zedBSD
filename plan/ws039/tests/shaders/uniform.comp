#version 450
// ws039-p007: push constants, a uniform buffer, a run-time array's length, and stores under an early return.
layout(local_size_x = 32) in;
layout(std140, set = 0, binding = 0) uniform Params { uint bias; uint limit; uvec2 pair; } u;
layout(std430, set = 0, binding = 1) buffer Out { uint head; uint o[]; };
layout(std430, set = 0, binding = 2) readonly buffer In { uint v[]; };
layout(push_constant) uniform Push { uint scale; uint offset; } p;
void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i == 0u)
		head = uint(v.length()) + uint(o.length()) * 1000u;
	if (i >= u.limit + 10u)
		return;
	o[i] = v[i] * p.scale + u.bias + u.pair.y * p.offset;
}
