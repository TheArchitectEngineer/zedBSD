#version 450
// ws039-p007: float arithmetic, roundings, minimum and maximum, conversions and a selection.
layout(local_size_x = 48) in;
layout(std430, set = 0, binding = 0) readonly buffer In { float x[]; };
layout(std430, set = 0, binding = 1) buffer Out { float o[]; };
layout(push_constant) uniform Push { float scale; uint count; } p;
void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= p.count)
		return;
	float v = x[i] * p.scale + x[i + 1u];
	float r = fract(v) - floor(v) * 0.5 + abs(v - 1.25) - trunc(v * 3.0) + roundEven(v * 2.5);
	r = r * min(v, 2.0) - max(v, -0.75) / 4.0;
	r = (v < 0.5 || v >= 3.0) ? r : -r;
	o[i * 4u] = r;
	o[i * 4u + 1u] = float(int(v * 3.0)) + float(i) - float(uint(abs(v) * 7.0));
	o[i * 4u + 2u] = (v == x[i] ? 1.0 : 0.0) + (v != 1.0 ? 2.0 : 0.0) + 1.0 / (abs(v) + 1.0);
	o[i * 4u + 3u] = sqrt(abs(v)) * 0.5 + 0.0625;
}
