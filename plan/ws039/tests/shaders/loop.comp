#version 450
// ws039-p007: loops whose trip counts differ between the lanes of a wave, nested, with values carried out.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer In { uint v[]; };
layout(std430, set = 0, binding = 1) buffer Out { uint o[]; };
void main()
{
	uint g = gl_GlobalInvocationID.x;
	uint n = v[g] % 9u;
	uint s = v[g + 1u];
	uint last = 0u;
	for (uint i = 0u; i < n; i++) {
		s += i * g + 1u;
		for (uint j = 0u; j < (v[i] & 3u) + 1u; j++)
			s ^= (j + 1u) << i;
		last = s * 3u;
	}
	uint k = 0u;
	while (k < 40u && (s & 1u) == 0u) {
		s = (s >> 1) + k;
		k++;
	}
	o[g * 3u] = s;
	o[g * 3u + 1u] = last;
	o[g * 3u + 2u] = k;
}
